<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\Doroti\src\Doroti.Runner.Sdk\Sdk\Sdk.props" />
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <AssemblyName>DorotiTestbedApp.Android</AssemblyName>
    <RootNamespace>DorotiTestbedApp.Android</RootNamespace>
    <DorotiAppProject>..\DorotiTestbedApp.csproj</DorotiAppProject>
    <DorotiTarget>Android</DorotiTarget>
    <DorotiHostKind>Maui</DorotiHostKind>
    <DorotiNativeEntryKind>Android-Application</DorotiNativeEntryKind>
    <UseMaui>true</UseMaui>
    <DefineConstants>$(DefineConstants);ANDROID;DOROTI_MAUI</DefineConstants>
    <SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <DorotiNativeBindingProject Include="binding\DorotiTestbedApp.Android.Native.csproj" />
    <DorotiTargetDescriptor Include="Android" HostKind="Maui" NativeEntryKind="Android-Application"
        RuntimeIdentifier="android-arm64" TargetFramework="net10.0-android"
        TargetPackage="Doroti.Target.Android.Maui.android-arm64" Condition="'$(RuntimeIdentifier)' == 'android-arm64'" />
    <DorotiTargetDescriptor Include="Android" HostKind="Maui" NativeEntryKind="Android-Application"
        RuntimeIdentifier="android-x64" TargetFramework="net10.0-android"
        TargetPackage="Doroti.Target.Android.Maui.android-x64" Condition="'$(RuntimeIdentifier)' == 'android-x64'" />
    <ProjectReference Include="..\..\Doroti\src\Doroti.Target.Android.Maui.android-arm64\Doroti.Target.Android.Maui.android-arm64.csproj"
        AdditionalProperties="RuntimeIdentifier=android-arm64" Condition="'$(RuntimeIdentifier)' == 'android-arm64'" />
    <ProjectReference Include="..\..\Doroti\src\Doroti.Target.Android.Maui.android-x64\Doroti.Target.Android.Maui.android-x64.csproj"
        AdditionalProperties="RuntimeIdentifier=android-x64" Condition="'$(RuntimeIdentifier)' == 'android-x64'" />
  </ItemGroup>
  <Import Project="..\..\Doroti\src\Doroti.Runner.Sdk\Sdk\Sdk.targets" />
</Project>
