{
  "schemaVersion": "doroti.dart-semantics/v1",
  "compilerProfile": "flutter-framework-f0",
  "rules": [
    { "semantic": "named-parameters", "classification": "typed-ir", "lowering": "csharp-named-arguments" },
    { "semantic": "optional-parameters", "classification": "typed-ir", "lowering": "csharp-default-parameters" },
    { "semantic": "cascades", "classification": "typed-ir", "lowering": "temporary-receiver-sequence" },
    { "semantic": "collection-if-for-spread", "classification": "typed-ir", "lowering": "builder-sequence" },
    { "semantic": "async-future-stream", "classification": "runtime-binding", "lowering": "Doroti.Flutter.Runtime Future and Stream" },
    { "semantic": "extension", "classification": "typed-ir", "lowering": "csharp-extension-method" },
    { "semantic": "mixin-application", "classification": "typed-ir", "lowering": "interface-default-members-and-composition" },
    { "semantic": "factory-named-constructor", "classification": "typed-ir", "lowering": "factory-method-and-constructor" },
    { "semantic": "operator", "classification": "typed-ir", "lowering": "csharp-operator-or-named-runtime-binding" },
    { "semantic": "late-final-const", "classification": "typed-ir", "lowering": "definite-assignment-readonly-and-constant" },
    { "semantic": "pattern-switch", "classification": "typed-ir", "lowering": "csharp-pattern-switch" },
    { "semantic": "tear-off", "classification": "typed-ir", "lowering": "typed-delegate" },
    { "semantic": "null-safety", "classification": "typed-ir", "lowering": "nullable-reference-and-flow-state" },
    { "semantic": "generic-variance", "classification": "typed-ir", "lowering": "variance-audit-and-adapter" },
    { "semantic": "isolate", "classification": "runtime-primitive", "lowering": "explicit-Doroti-isolate-runtime" },
    { "semantic": "zone", "classification": "runtime-primitive", "lowering": "explicit-Doroti-zone-runtime" },
    { "semantic": "ffi", "classification": "platform-port", "lowering": "explicit-native-port" },
    { "semantic": "dart-ui-native", "classification": "platform-port", "lowering": "Doroti-engine-binding" },
    { "semantic": "method-channel", "classification": "platform-port", "lowering": "generated-consumer-port" },
    { "semantic": "vm-intrinsic", "classification": "runtime-primitive", "lowering": "explicit-Doroti-runtime-binding" }
  ]
}
