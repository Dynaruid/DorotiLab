{
  "schemaVersion": "doroti.avalonia-frame-fixture/v1",
  "id": "display-list-image-lifecycle",
  "displayListCommands": [
    "drawColor",
    "drawRect",
    "drawRect",
    "drawPath",
    "drawImage"
  ],
  "image": {
    "width": 2,
    "height": 2,
    "pixelFormat": "premultiplied-bgra8888",
    "pixelsBase64": "AAD//wD/AP//AAD//////w=="
  },
  "requiredAckStatuses": [
    "presented",
    "stale",
    "superseded",
    "failed"
  ],
  "hardwareSoftwareAverageByteDeltaTolerance": 0.0,
  "targets": [
    { "id": "windows", "status": "verified-by-h2-target-suite" },
    { "id": "linux", "status": "not-verified" },
    { "id": "macos", "status": "not-verified" }
  ]
}
