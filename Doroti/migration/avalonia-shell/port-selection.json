      "paths": ["src/Avalonia.Wayland"],
      "extensions": [".cs"],
      "disposition": "adapt",
      "owner": "Doroti.Vendor.Avalonia.Wayland",
      "targetProject": "Doroti.Vendor.Avalonia.Wayland",
      "reason": "Wayland is retained as an explicit second Linux closure, not silently treated as covered by X11."
    },
    {
      "id": "macos-managed",
