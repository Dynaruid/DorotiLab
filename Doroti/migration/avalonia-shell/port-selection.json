  "dependencyRules": [
    {
      "id": "avalonia-composition-cut",
      "prefixes": ["Avalonia.Rendering.Composition"],
      "disposition": "exclude-with-owner",
      "owner": "A2 Doroti direct frame pipeline",
      "reason": "Avalonia composition is replaced by Doroti DisplayList, LayerTree, mailbox and terminal ACK contracts."
    },
    {
      "id": "avalonia-ui-cut",
      "prefixes": ["Avalonia.Controls", "Avalonia.Styling", "Avalonia.VisualTree", "Avalonia.Markup"],
      "disposition": "exclude-with-owner",
      "owner": "Doroti.Shell.Core compatibility seam",
      "reason": "Only platform-facing contracts cross the shell seam; Control, styling, XAML and Avalonia visual-tree semantics remain outside the product framework."
    },
    {
      "id": "avalonia-automation-port",
      "prefixes": ["Avalonia.Automation"],
      "disposition": "Doroti-port",
      "owner": "Doroti semantics bridge",
      "reason": "Native providers consume Doroti-owned semantics and automation DTOs."
    },
    {
      "id": "avalonia-core-port",
      "prefixes": ["Avalonia"],
      "disposition": "Doroti-port",
      "owner": "Doroti.Shell.Core",
      "reason": "Geometry, property notifications, input DTOs, service lookup and lifetime primitives are explicit internal compatibility ports."
    },
    {
      "id": "dotnet-and-generators",
      "prefixes": ["System", "Microsoft", "MicroCom", "SharpGen", "Silk", "Windows.Win32"],
      "disposition": "Doroti-port",
      "owner": "Doroti vendor build",
      "reason": "BCL, interop generators and native bindings are build/runtime dependencies rather than copied Avalonia symbols."
    },
    {
      "id": "graphics-runtime",
      "prefixes": ["SkiaSharp", "OpenTK", "NWayland", "Tmds", "HarfBuzzSharp"],
      "disposition": "Doroti-port",
      "owner": "Doroti platform and graphics adapters",
      "reason": "External graphics, Wayland and DBus APIs are pinned independently at the vendor adapter boundary."
    }
  ],
