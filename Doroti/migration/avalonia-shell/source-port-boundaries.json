{
  "schemaVersion": "doroti.source-port-boundaries/v2",
  "decision": "flutter-framework-over-avalonia-source-port",
  "projectRules": [
    {
      "id": "flutter-runtime",
      "assemblyPattern": "Doroti.Flutter.Runtime",
      "allowedReferencePatterns": [],
      "responsibility": "Dart language/runtime primitives; host reference zero after the recorded G4-1 transition."
    },
    {
      "id": "flutter-ui",
      "assemblyPattern": "Doroti.Flutter.Ui*",
      "allowedReferencePatterns": ["Doroti.Flutter.Runtime"],
      "responsibility": "Managed dart:ui API and host-neutral capability contracts."
    },
    {
      "id": "flutter-framework",
      "assemblyPattern": "Doroti.Flutter.Framework*",
      "allowedReferencePatterns": ["Doroti.Flutter.Runtime", "Doroti.Flutter.Ui*", "Doroti.Flutter.Framework*"],
      "responsibility": "Reviewed Flutter packages/flutter/lib source only."
    },
    {
      "id": "flutter-hosting",
      "assemblyPattern": "Doroti.Flutter.Hosting*",
      "allowedReferencePatterns": ["Doroti.Flutter.Runtime", "Doroti.Flutter.Ui*", "Doroti.Flutter.Framework*"],
      "responsibility": "Host-neutral framework bootstrap and per-view capability binding."
    },
    {
      "id": "desktop-flutter-composition",
      "assemblyPattern": "Doroti.Host.Desktop.Flutter*",
      "allowedReferencePatterns": ["Doroti.Flutter*", "Doroti.Host.Desktop", "Doroti.Core", "Doroti.Platform", "Doroti.Graphics", "Doroti.Composition", "Doroti.Shell.*"],
      "responsibility": "Concrete composition adapter; no framework behavior and no vendor/native type in public API."
    },
    {
      "id": "vendor-source",
      "assemblyPattern": "Doroti.Vendor.Avalonia.*",
      "allowedReferencePatterns": ["Doroti.Vendor.Avalonia.*", "Doroti.Shell.Core"],
      "responsibility": "Pinned Avalonia source adaptation with zero Flutter/framework references."
    },
    {
      "id": "shell",
      "assemblyPattern": "Doroti.Shell.*",
      "allowedReferencePatterns": ["Doroti.Core", "Doroti.Graphics", "Doroti.Platform", "Doroti.Shell.*", "Doroti.Vendor.Avalonia.*"],
      "responsibility": "Host-neutral shell contracts and selected source-port composition."
    },
    {
      "id": "desktop-host",
      "assemblyPattern": "Doroti.Host.*",
      "allowedReferencePatterns": ["Doroti.*"],
      "responsibility": "Native shell/graphics product composition; Flutter bridge is isolated in the more-specific desktop-flutter rule."
    },
    {
      "id": "render-backend",
      "assemblyPattern": "Doroti.Backends.*",
      "allowedReferencePatterns": ["Doroti.Core", "Doroti.Graphics", "Doroti.Platform", "Doroti.Composition", "Doroti.Vendor.Avalonia.*"],
      "responsibility": "Host-neutral rendering adapter over selected vendor source."
    },
    {
      "id": "engine-transition",
      "assemblyPattern": "Doroti.Engine",
      "allowedReferencePatterns": ["Doroti.Core", "Doroti.Graphics", "Doroti.Platform", "Doroti.Composition", "Doroti.Rendering"],
      "responsibility": "Host-neutral frame, mailbox and raster-pipeline owner after framework cutover."
    },
    {
      "id": "neutral-contracts",
      "assemblyPattern": "Doroti*",
      "allowedReferencePatterns": ["Doroti.Core", "Doroti.Graphics", "Doroti.Platform", "Doroti.Composition", "Doroti.Rendering", "Doroti.Flutter*", "Doroti.Engine"],
      "responsibility": "Fallback rule for current neutral projects; earlier rules take precedence."
    }
  ],
  "forbiddenEdges": [
    {
      "fromPattern": "Doroti.Vendor.Avalonia.*",
      "toPatterns": ["Doroti.Backends.*", "Doroti.Engine", "Doroti.Flutter*", "Doroti.Host.*", "Doroti.Rendering"],
      "diagnostic": "DOTARCH007",
      "reason": "Imported platform source stays below product adapters and never references Flutter-owned layers."
    },
    {
      "fromPattern": "Doroti.Flutter.Runtime*",
      "toPatterns": ["Doroti.Core", "Doroti.Platform", "Doroti.Graphics", "Doroti.Composition", "Doroti.Rendering", "Doroti.Engine", "Doroti.Backends.*", "Doroti.Host.*", "Doroti.Shell.*", "Doroti.Vendor.*", "Avalonia*", "SkiaSharp*", "Windows.Win32"],
      "diagnostic": "DOTARCH009",
      "reason": "The Dart runtime owns language semantics and has no host/platform reference."
    },
    {
      "fromPattern": "Doroti.Flutter.Ui*",
      "toPatterns": ["Doroti.Core", "Doroti.Platform", "Doroti.Graphics", "Doroti.Composition", "Doroti.Rendering", "Doroti.Engine", "Doroti.Backends.*", "Doroti.Host.*", "Doroti.Shell.*", "Doroti.Vendor.*", "Avalonia*", "SkiaSharp*", "Windows.Win32"],
      "diagnostic": "DOTARCH009",
      "reason": "dart:ui contracts do not select a concrete host."
    },
    {
      "fromPattern": "Doroti.Flutter.Framework*",
      "toPatterns": ["Doroti.Core", "Doroti.Platform", "Doroti.Graphics", "Doroti.Composition", "Doroti.Rendering", "Doroti.Engine", "Doroti.Backends.*", "Doroti.Host.*", "Doroti.Shell.*", "Doroti.Vendor.*", "Avalonia*", "SkiaSharp*", "Windows.Win32"],
      "diagnostic": "DOTARCH009",
      "reason": "Reviewed Flutter framework code depends only on Flutter Runtime, Ui, and framework peers."
    },
    {
      "fromPattern": "Doroti.Flutter.Hosting*",
      "toPatterns": ["Doroti.Platform", "Doroti.Graphics", "Doroti.Composition", "Doroti.Engine", "Doroti.Backends.*", "Doroti.Host.*", "Doroti.Shell.*", "Doroti.Vendor.*", "Avalonia*", "SkiaSharp*", "Windows.Win32"],
      "diagnostic": "DOTARCH009",
      "reason": "Host-neutral bootstrap does not bind a concrete platform."
    },
    {
      "fromPattern": "Doroti.Rendering",
      "toPatterns": ["Doroti.Backends.*", "Doroti.Host.*", "Doroti.Shell.*", "Doroti.Vendor.*"],
      "diagnostic": "DOTARCH001",
      "reason": "Rendering bridge contracts do not select a platform implementation."
    }
  ],
  "transitionEdges": [],
  "avaloniaPackagePolicy": {
    "default": "forbidden",
    "comparisonOnlyProjects": [],
    "productTransitionAllowances": []
  },
  "publicApiForbiddenPrefixes": ["Avalonia", "Doroti.Backends.", "Doroti.Vendor.", "SkiaSharp", "Windows.Win32"],
  "failureFixtures": [
    {
      "path": "validation/architecture/forbidden-flutter-host/Doroti.Flutter.Framework.ForbiddenFixture.csproj",
      "edge": "Doroti.Flutter.Framework.ForbiddenFixture -> Doroti.Platform",
      "expectedDiagnostic": "DOTARCH009",
      "validationOwner": "eng/validate-g4-boundary.sh"
    }
  ]
}
