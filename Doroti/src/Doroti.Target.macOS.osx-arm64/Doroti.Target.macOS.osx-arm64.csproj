<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Doroti.Host.macOS</AssemblyName>
    <RootNamespace>Doroti.Target.macOS</RootNamespace>
    <PackageId>Doroti.Target.macOS.osx-arm64</PackageId>
    <Description>Doroti source-ported AppKit/libAvalonia OpenGL Flutter host for osx-arm64.</Description>
    <IsDorotiProduct>true</IsDorotiProduct>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Doroti.Hosting\Doroti.Hosting.csproj" />
    <ProjectReference Include="..\Doroti.Ui\Doroti.Ui.csproj" />
    <ProjectReference Include="..\Doroti.Host.Desktop\Doroti.Host.Desktop.csproj" />
    <ProjectReference Include="..\Doroti.Host.Desktop.Framework\Doroti.Host.Desktop.Framework.csproj" />
    <ProjectReference Include="..\Doroti.Platform\Doroti.Platform.csproj" />
    <ProjectReference Include="..\Doroti.Shell.Core\Doroti.Shell.Core.csproj" />
    <ProjectReference Include="..\Doroti.Vendor.Avalonia.Native\Doroti.Vendor.Avalonia.Native.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="doroti-target-manifest.json" LogicalName="Doroti.Target.Manifest" />
    <None Include="doroti-target-manifest.json" Pack="true" PackagePath="doroti/" />
    <None Include="..\..\migration\avalonia-shell\g7-macos-source-port-provenance.json"
          Link="source-port/provenance.json" Pack="true" PackagePath="source-port/provenance.json" />
    <None Include="..\..\LICENSES\Avalonia-LICENSE.md" Condition="Exists('..\..\LICENSES\Avalonia-LICENSE.md')"
          Link="licenses/Avalonia-LICENSE.md" Pack="true" PackagePath="licenses/" />
  </ItemGroup>
</Project>
