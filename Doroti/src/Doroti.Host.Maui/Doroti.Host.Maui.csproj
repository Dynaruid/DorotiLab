<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework></TargetFramework>
    <DorotiIosTargetFramework Condition="'$(DorotiIosTargetFramework)' == ''">net10.0-ios</DorotiIosTargetFramework>
    <TargetFrameworks Condition="'$(RuntimeIdentifier)' == '' and '$(DorotiHostMacOnly)' == 'true'">net10.0-maccatalyst;net10.0-macos</TargetFrameworks>
    <TargetFrameworks Condition="'$(RuntimeIdentifier)' == '' and '$(DorotiHostMacOnly)' != 'true' and '$(DorotiHostTargetFrameworks)' == ''">net10.0-windows10.0.19041.0;net10.0-maccatalyst;net10.0-macos;$(DorotiIosTargetFramework);net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="'$(RuntimeIdentifier)' == '' and '$(DorotiHostTargetFrameworks)' != ''">$(DorotiHostTargetFrameworks)</TargetFrameworks>
    <TargetFrameworks Condition="'$(RuntimeIdentifier)' == 'win-x64'">net10.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(RuntimeIdentifier)' == 'maccatalyst-arm64'">net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">net10.0-macos</TargetFrameworks>
    <TargetFrameworks Condition="'$(RuntimeIdentifier)' == 'ios-arm64' or '$(RuntimeIdentifier)' == 'iossimulator-arm64' or '$(RuntimeIdentifier)' == 'iossimulator-x64'">$(DorotiIosTargetFramework)</TargetFrameworks>
    <TargetFrameworks Condition="'$(RuntimeIdentifier)' == 'android-arm64'">net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="'$(RuntimeIdentifier)' == 'android-x64'">net10.0-android</TargetFrameworks>
    <!-- NativeAot is an iOS device profile, including RID-less restore queries. -->
    <TargetFrameworks Condition="'$(DorotiCompilationMode)' == 'NativeAot'">$(DorotiIosTargetFramework)</TargetFrameworks>
    <AssemblyName>Doroti.Host.Maui</AssemblyName>
    <PackageId>Doroti.Host.Maui</PackageId>
    <Description>Doroti MAUI SKGLView host with externally owned GPU surface lifecycle.</Description>
    <IsDorotiProduct>true</IsDorotiProduct>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <EnableDefaultMauiItems>false</EnableDefaultMauiItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The unmanaged Graphite DLL is distributed by buildTransitive outside lib/. -->
    <NoWarn>$(NoWarn);NU5100</NoWarn>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**</DefaultItemExcludes>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'macos'">14.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <None Include="buildTransitive\Doroti.Host.Maui.targets" Pack="true" PackagePath="buildTransitive\" />
    <ProjectReference Include="..\Doroti.Skia.Vulkan\Doroti.Skia.Vulkan.csproj" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'" />
    <ProjectReference Include="..\Doroti.Skia.Rendering\Doroti.Skia.Rendering.csproj" />
    <PackageReference Include="Microsoft.Maui.Controls" Condition="'$(DorotiIosMauiVersion)' == '' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'ios'" />
    <PackageReference Include="Microsoft.Maui.Controls" VersionOverride="$(DorotiIosMauiVersion)" Condition="'$(DorotiIosMauiVersion)' != '' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'" />
    <PackageReference Include="Xamarin.AndroidX.Window.WindowJava" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'" />
    <PackageReference Include="SkiaSharp.Views.Maui.Controls" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'macos'" />
    <PackageReference Include="Microsoft.Maui.Platforms.MacOS" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'macos'" />
    <PackageReference Include="Microsoft.Maui.Platforms.MacOS.Essentials" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'macos'" />
    <PackageReference Include="SkiaSharp.Views" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'macos'" />
    <ProjectReference Include="..\Doroti.Hosting\Doroti.Hosting.csproj" />
    <ProjectReference Include="..\Doroti.Ui\Doroti.Ui.csproj" />
    <ProjectReference Include="..\Doroti.Skia.RuntimeEffects\Doroti.Skia.RuntimeEffects.csproj" />
  </ItemGroup>
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <DorotiGraphiteAndroidCpu Condition="'$(RuntimeIdentifier)' != 'android-x64'">arm64</DorotiGraphiteAndroidCpu>
    <DorotiGraphiteAndroidCpu Condition="'$(RuntimeIdentifier)' == 'android-x64'">x64</DorotiGraphiteAndroidCpu>
    <DorotiGraphiteAndroidAbi Condition="'$(RuntimeIdentifier)' != 'android-x64'">arm64-v8a</DorotiGraphiteAndroidAbi>
    <DorotiGraphiteAndroidAbi Condition="'$(RuntimeIdentifier)' == 'android-x64'">x86_64</DorotiGraphiteAndroidAbi>
    <DorotiGraphiteAndroidDistribution>$(MSBuildThisFileDirectory)..\..\artifacts\native-graphite\distribution\android-$(DorotiGraphiteAndroidCpu)</DorotiGraphiteAndroidDistribution>
  </PropertyGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <PackageReference Include="SkiaSharp.NativeAssets.Android" ExcludeAssets="all" />
    <EmbeddedNativeLibrary Include="$(DorotiGraphiteAndroidDistribution)\libSkiaSharp.so" Link="lib\$(DorotiGraphiteAndroidAbi)\libSkiaSharp.so" Abi="$(DorotiGraphiteAndroidAbi)" />
    <!-- A RID-neutral Android NuGet/AAR must support both advertised targets. -->
    <EmbeddedNativeLibrary Include="$(MSBuildThisFileDirectory)..\..\artifacts\native-graphite\distribution\android-x64\libSkiaSharp.so" Link="lib\x86_64\libSkiaSharp.so" Abi="x86_64" Condition="'$(RuntimeIdentifier)' == ''" />
    <AndroidAsset Include="$(DorotiGraphiteAndroidDistribution)\build-provenance.json;$(DorotiGraphiteAndroidDistribution)\LICENSE.txt;$(DorotiGraphiteAndroidDistribution)\THIRD-PARTY-NOTICES.txt" Link="graphite\android-$(DorotiGraphiteAndroidCpu)\%(Filename)%(Extension)" />
    <AndroidAsset Include="$(MSBuildThisFileDirectory)..\..\artifacts\native-graphite\distribution\android-x64\build-provenance.json;$(MSBuildThisFileDirectory)..\..\artifacts\native-graphite\distribution\android-x64\LICENSE.txt;$(MSBuildThisFileDirectory)..\..\artifacts\native-graphite\distribution\android-x64\THIRD-PARTY-NOTICES.txt" Link="graphite\android-x64\%(Filename)%(Extension)" Condition="'$(RuntimeIdentifier)' == ''" />
    <DorotiLaunchDependency Include="$(DorotiGraphiteAndroidDistribution)\libSkiaSharp.so;$(MSBuildThisFileDirectory)..\..\native\graphite\stage-android.py" />
  </ItemGroup>
  <Target Name="EnsureDorotiGraphiteAndroidAsset" BeforeTargets="PrepareForBuild;DorotiCollectLaunchInputs;DorotiCollectLaunchDependencies" Condition="'$(DesignTimeBuild)' != 'true' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <Exec Command="python &quot;$(MSBuildThisFileDirectory)..\..\native\graphite\stage-android.py&quot; --cpu $(DorotiGraphiteAndroidCpu)" Timeout="1200000" />
    <Exec Command="python &quot;$(MSBuildThisFileDirectory)..\..\native\graphite\stage-android.py&quot; --cpu x64" Timeout="1200000" Condition="'$(RuntimeIdentifier)' == ''" />
  </Target>
  <PropertyGroup>
    <DorotiGraphiteWindowsDistribution>$(MSBuildThisFileDirectory)..\..\artifacts\native-graphite\distribution\win-x64</DorotiGraphiteWindowsDistribution>
  </PropertyGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' or ('$(TargetFramework)' == '' and ('$(RuntimeIdentifier)' == 'win-x64' or $([System.String]::Copy('$(TargetFrameworks)').Contains('-windows'))))">
    <Content Include="$(DorotiGraphiteWindowsDistribution)\libSkiaSharp.dll" Link="graphite\libDorotiGraphite.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="true" PackagePath="nativeAssets\win-x64\graphite\libDorotiGraphite.dll" />
    <Content Include="$(DorotiGraphiteWindowsDistribution)\build-provenance.json;$(DorotiGraphiteWindowsDistribution)\LICENSE.txt;$(DorotiGraphiteWindowsDistribution)\THIRD-PARTY-NOTICES.txt" Link="graphite\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="true" PackagePath="nativeAssets\win-x64\graphite\" />
    <DorotiLaunchDependency Include="$(DorotiGraphiteWindowsDistribution)\libSkiaSharp.dll;$(DorotiGraphiteWindowsDistribution)\build-provenance.json" />
  </ItemGroup>
  <Target Name="EnsureDorotiGraphiteMauiWindowsAsset" BeforeTargets="PrepareForBuild;DorotiCollectLaunchInputs;DorotiCollectLaunchDependencies" Condition="'$(DesignTimeBuild)' != 'true' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <Exec Command="python &quot;$(MSBuildThisFileDirectory)..\..\native\graphite\build-windows.py&quot; --ensure-distribution" Timeout="1200000" />
  </Target>
  <ItemGroup>
    <ProjectReference Include="..\Doroti.Graphics.DirectX\Doroti.Graphics.DirectX.csproj" GlobalPropertiesToRemove="WindowsAppSdkUndockedRegFreeWinRTInitialize;WindowsAppSdkAutoInitialize" Condition="$([System.String]::Copy('$(TargetFramework)').Contains('-windows'))" />
  </ItemGroup>
</Project>
