<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Doroti.Host.Avalonia</AssemblyName>
    <IsDorotiProduct>false</IsDorotiProduct>
    <IsPackable>false</IsPackable>
    <Description>Comparison-only Avalonia package host retained for A/B and historical runtime evidence.</Description>
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Doroti.Composition\Doroti.Composition.csproj" />
    <ProjectReference Include="..\Doroti.Core\Doroti.Core.csproj" />
    <ProjectReference Include="..\Doroti.Engine\Doroti.Engine.csproj" />
    <ProjectReference Include="..\Doroti.Graphics\Doroti.Graphics.csproj" />
    <ProjectReference Include="..\Doroti.Platform\Doroti.Platform.csproj" />
    <ProjectReference Include="..\Doroti.Rendering\Doroti.Rendering.csproj" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
  </ItemGroup>
</Project>
