<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Doroti.Vendor.Avalonia.Native</AssemblyName>
    <IsDorotiProduct>true</IsDorotiProduct>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <NativeOutput>$(MSBuildProjectDirectory)/runtimes/osx-arm64/native/libAvalonia.dylib</NativeOutput>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Doroti.Shell.Core\Doroti.Shell.Core.csproj" />
    <ProjectReference Include="..\Doroti.Platform\Doroti.Platform.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="native/include/doroti-avalonia-native.h" Pack="true" PackagePath="source-port/generated/" />
    <None Include="native/src/DorotiAvnAppKit.mm" Pack="true" PackagePath="source-port/native/" />
    <None Include="runtimes/osx-arm64/native/libAvalonia.dylib"
          Condition="Exists('runtimes/osx-arm64/native/libAvalonia.dylib')"
          Link="libAvalonia.dylib"
          Pack="true" PackagePath="runtimes/osx-arm64/native/"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildDorotiAvaloniaNative" BeforeTargets="CoreCompile" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <MakeDir Directories="$(MSBuildProjectDirectory)/runtimes/osx-arm64/native" />
    <Exec Command="xcrun clang++ -std=c++17 -fobjc-arc -Wno-deprecated-declarations -dynamiclib -arch arm64 -mmacosx-version-min=13.0 -install_name @rpath/libAvalonia.dylib -framework AppKit -framework OpenGL -framework CoreGraphics -I&quot;$(MSBuildProjectDirectory)/native/include&quot; &quot;$(MSBuildProjectDirectory)/native/src/DorotiAvnAppKit.mm&quot; -o &quot;$(NativeOutput)&quot;" />
  </Target>
</Project>
