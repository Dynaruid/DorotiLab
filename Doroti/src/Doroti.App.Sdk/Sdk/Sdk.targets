<Project>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="src/**/*.cs" />
    <EmbeddedResource Include="assets/shaders/**/*.sksl"
                      LogicalName="Doroti.Shaders.%(RecursiveDir)%(Filename)%(Extension)"
                      Condition="Exists('assets/shaders')" />
  </ItemGroup>

  <Target Name="ValidateDorotiPlatformNeutralApplication" BeforeTargets="PrepareForBuild;Restore">
    <ItemGroup>
      <_DorotiForbiddenApplicationSource Include="@(Compile)"
          Condition="$([System.String]::Copy('%(Compile.Identity)').Replace('%5C', '/').Contains('Platforms/'))" />
      <_DorotiForbiddenApplicationReference Include="@(ProjectReference)"
          Condition="$([System.String]::Copy('%(ProjectReference.Filename)').Contains('Doroti.Host.Maui')) or
                     $([System.String]::Copy('%(ProjectReference.Filename)').Contains('Doroti.Host.Web')) or
                     $([System.String]::Copy('%(ProjectReference.Filename)').Contains('Doroti.Host.Qt')) or
                     $([System.String]::Copy('%(ProjectReference.Filename)').Contains('Doroti.Target.')) or
                     $([System.String]::Copy('%(ProjectReference.Filename)').EndsWith('.Android.Native')) or
                     $([System.String]::Copy('%(ProjectReference.Filename)').EndsWith('.iOS.Native')) or
                     $([System.String]::Copy('%(ProjectReference.Filename)').EndsWith('.MacCatalyst.Native'))" />
      <_DorotiForbiddenApplicationPackage Include="@(PackageReference)"
          Condition="$([System.String]::Copy('%(PackageReference.Identity)').StartsWith('Microsoft.Maui')) or
                     $([System.String]::Copy('%(PackageReference.Identity)').StartsWith('Microsoft.AspNetCore.Components.WebAssembly')) or
                     $([System.String]::Copy('%(PackageReference.Identity)').StartsWith('Doroti.Host.')) or
                     $([System.String]::Copy('%(PackageReference.Identity)').StartsWith('Doroti.Target.'))" />
    </ItemGroup>
    <Error Code="DOROTIAPP101" Condition="'$(TargetFramework)' != 'net10.0'"
           Text="A Doroti application project is platform-neutral and requires TargetFramework 'net10.0'; found '$(TargetFramework)'." />
    <Error Code="DOROTIAPP102" Condition="'$(UseMaui)' == 'true' or '$(UsingMicrosoftNETSdkBlazorWebAssembly)' == 'true'"
           Text="A Doroti application project cannot enable MAUI or the Blazor WebAssembly SDK. Move the platform host to a runner project." />
    <Error Code="DOROTIAPP103" Condition="'@(_DorotiForbiddenApplicationSource)' != ''"
           Text="Platform source is forbidden in a Doroti application project: @(_DorotiForbiddenApplicationSource)." />
    <Error Code="DOROTIAPP104" Condition="'@(_DorotiForbiddenApplicationReference)' != '' or '@(_DorotiForbiddenApplicationPackage)' != ''"
           Text="Platform host/target references are forbidden in a Doroti application project: @(_DorotiForbiddenApplicationReference) @(_DorotiForbiddenApplicationPackage)." />
    <Error Code="DOROTIAPP100" Condition="'$(DorotiTarget)' != ''"
           Text="The single-project DorotiTarget command has been removed. Use 'Doroti/eng/doroti.ps1 build --app &lt;path&gt; --platform &lt;name&gt;' or build the platform runner project directly." />
  </Target>

  <Target Name="GetDorotiApplicationContract" Returns="@(_DorotiApplicationContract)">
    <ItemGroup>
      <_DorotiApplicationContract Include="$(MSBuildProjectFullPath)" Kind="Application"
          TargetFramework="$(TargetFramework)" StartupType="$(DorotiApplicationType)" AssemblyName="$(AssemblyName)" />
      <_DorotiApplicationContract Include="@(EmbeddedResource)" Kind="Asset"
          LogicalName="%(EmbeddedResource.LogicalName)" />
    </ItemGroup>
  </Target>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
