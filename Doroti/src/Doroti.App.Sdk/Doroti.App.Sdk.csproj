<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Doroti.App.Sdk</PackageId>
    <Description>Platform-neutral MSBuild SDK for Doroti application assemblies.</Description>
    <IsDorotiProduct>false</IsDorotiProduct>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <IncludeSymbols>false</IncludeSymbols>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <None Include="Sdk\Sdk.props" Pack="true" PackagePath="Sdk\Sdk.props" />
    <None Include="Sdk\Sdk.targets" Pack="true" PackagePath="Sdk\Sdk.targets" />
    <None Include="Sdk\Doroti.GpuEffects.targets" Pack="true" PackagePath="Sdk\Doroti.GpuEffects.targets" />
    <None Include="..\Doroti.Runner.Sdk\Sdk\Doroti.DesktopBoundary.targets" Pack="true" PackagePath="Sdk\Doroti.DesktopBoundary.targets" Link="Sdk\Doroti.DesktopBoundary.targets" />
    <None Include="Sdk\Doroti.TypeScript.targets" Pack="true" PackagePath="Sdk\Doroti.TypeScript.targets" />
  </ItemGroup>
</Project>
