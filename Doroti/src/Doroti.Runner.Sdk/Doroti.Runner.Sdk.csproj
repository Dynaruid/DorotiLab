<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Doroti.Runner.Sdk</PackageId>
    <Description>Fixed-target runner SDK for Doroti platform workspaces.</Description>
    <IsDorotiProduct>false</IsDorotiProduct>
    <IsPackable>true</IsPackable>
    <Version>0.3.0-beta</Version>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <IncludeSymbols>false</IncludeSymbols>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <None Include="Sdk\Sdk.props" Pack="true" PackagePath="Sdk\Sdk.props" />
    <None Include="Sdk\Doroti.MacCatalyst.props" Pack="true" PackagePath="Sdk\Doroti.MacCatalyst.props" />
    <None Include="Sdk\Doroti.MacDevelopment.Common.targets" Pack="true" PackagePath="Sdk\Doroti.MacDevelopment.Common.targets" />
    <None Include="Sdk\Doroti.MacDevelopment.Transport.targets" Pack="true" PackagePath="Sdk\Doroti.MacDevelopment.Transport.targets" />
    <None Include="Sdk\Doroti.MacDevelopment.targets" Pack="true" PackagePath="Sdk\Doroti.MacDevelopment.targets" />
    <None Include="Sdk\Doroti.AndroidDevelopment.targets" Pack="true" PackagePath="Sdk\Doroti.AndroidDevelopment.targets" />
    <None Include="Sdk\Doroti.MacOS.props" Pack="true" PackagePath="Sdk\Doroti.MacOS.props" />
    <None Include="Sdk\Doroti.IosNativeAot.props" Pack="true" PackagePath="Sdk\Doroti.IosNativeAot.props" />
    <None Include="Sdk\Doroti.IosDevelopmentBinding.targets" Pack="true" PackagePath="Sdk\Doroti.IosDevelopmentBinding.targets" />
    <None Include="Sdk\IosDevelopmentNetwork.plist" Pack="true" PackagePath="Sdk\IosDevelopmentNetwork.plist" />
    <None Include="Sdk\Doroti.NativeAot.Evidence.targets" Pack="true" PackagePath="Sdk\Doroti.NativeAot.Evidence.targets" />
    <None Include="Sdk\Sdk.targets" Pack="true" PackagePath="Sdk\Sdk.targets" />
    <None Include="Sdk\Doroti.AppIcons.targets" Pack="true" PackagePath="Sdk\Doroti.AppIcons.targets" />
    <None Include="Sdk\Icons\*" Pack="true" PackagePath="Sdk\Icons\" />
    <None Include="Sdk\Doroti.DesktopBoundary.targets" Pack="true" PackagePath="Sdk\Doroti.DesktopBoundary.targets" />
    <None Include="Sdk\Doroti.Plugins.targets" Pack="true" PackagePath="Sdk\Doroti.Plugins.targets" />
    <None Include="Sdk\Doroti.Qt.targets" Pack="true" PackagePath="Sdk\Doroti.Qt.targets" />
    <None Include="Sdk\Doroti.Web.targets" Pack="true" PackagePath="Sdk\Doroti.Web.targets" />
    <None Include="..\Doroti.App.Sdk\Sdk\Doroti.TypeScript.targets" Pack="true" PackagePath="Sdk\Doroti.TypeScript.targets" Link="Sdk\Doroti.TypeScript.targets" />
    <None Include="..\Doroti.Host.Web\Web\types\doroti-loader\index.d.ts" Pack="true" PackagePath="Sdk\types\doroti-loader\index.d.ts" Link="Sdk\types\doroti-loader\index.d.ts" />
    <None Include="..\Doroti.Host.Web\Web\types\doroti-textures\index.d.ts" Pack="true" PackagePath="Sdk\types\doroti-textures\index.d.ts" Link="Sdk\types\doroti-textures\index.d.ts" />
  </ItemGroup>
</Project>
