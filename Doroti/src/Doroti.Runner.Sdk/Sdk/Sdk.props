<Project>
  <PropertyGroup>
    <DorotiCommonRunnerSdkDirectory>$(MSBuildThisFileDirectory)</DorotiCommonRunnerSdkDirectory>
    <DorotiRunnerSdkActive>true</DorotiRunnerSdkActive>
  </PropertyGroup>
  <Import Project="$(DorotiProviderSdkProps)" Condition="'$(DorotiProviderSdkPropsImported)' != 'true' and '$(DorotiProviderSdkProps)' != '' and Exists('$(DorotiProviderSdkProps)')" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**;binding\**;native\**</DefaultItemExcludes>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultXamlItems>false</EnableDefaultXamlItems>
    <DorotiVersion Condition="'$(DorotiVersion)' == ''">0.4.0-alpha.1</DorotiVersion>
    <SkiaSharpVersion Condition="'$(SkiaSharpVersion)' == ''">4.154.0-preview.1.26454.9</SkiaSharpVersion>
    <DorotiMarkupVersion Condition="'$(DorotiMarkupVersion)' == ''">8.0.0</DorotiMarkupVersion>
    <DorotiTypeScriptVersion Condition="'$(DorotiTypeScriptVersion)' == ''">7.0.0</DorotiTypeScriptVersion>
    <_DorotiGeneratedDirectory>$(BaseIntermediateOutputPath)Doroti.Generated/</_DorotiGeneratedDirectory>
    <_DorotiBootstrapFile>$(_DorotiGeneratedDirectory)DorotiBootstrap.g.cs</_DorotiBootstrapFile>
    <_DorotiPluginRegistrationFile>$(_DorotiGeneratedDirectory)DorotiPluginRegistration.g.cs</_DorotiPluginRegistrationFile>
    <_DorotiNativePluginRegistrationFile>$(_DorotiGeneratedDirectory)DorotiNativePluginRegistration.g.cs</_DorotiNativePluginRegistrationFile>
    <_DorotiRunnerWorkspaceDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)'))</_DorotiRunnerWorkspaceDirectory>
  </PropertyGroup>
</Project>