<Project>
  <PropertyGroup>
    <DorotiAppProject>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(DorotiAppProject)'))</DorotiAppProject>
    <DorotiApplicationProjectName>$([System.IO.Path]::GetFileNameWithoutExtension('$(DorotiAppProject)'))</DorotiApplicationProjectName>
    <DorotiApplicationType Condition="'$(DorotiApplicationType)' == ''">$(DorotiApplicationProjectName).Program</DorotiApplicationType>
  </PropertyGroup>
  <Import Project="$(DorotiProviderBootstrapTargets)" Condition="'$(DorotiProviderSuppliesBootstrap)' != 'true' and '$(DorotiProviderBootstrapTargets)' != '' and Exists('$(DorotiProviderBootstrapTargets)')" />
  <Import Project="Doroti.DesktopBoundary.targets" />
  <Import Project="Doroti.Plugins.targets" />
  <PropertyGroup>
    <_DorotiBootstrapFile Condition="'$(DorotiDesktopStartupType)' != ''">$(_DorotiGeneratedDirectory)DorotiBootstrap.Desktop.$(DorotiDesktopStartupType).g.cs</_DorotiBootstrapFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(DorotiDesktopProject)" Condition="'$(DorotiDesktopProject)' != ''" GlobalPropertiesToRemove="TargetFramework;TargetFrameworks;RuntimeIdentifier;RuntimeIdentifiers;DorotiTarget;DorotiHostKind;DorotiNativeEntryKind" />
    <DorotiNativeBindingProject Update="@(DorotiNativeBindingProject)">
      <DorotiFullPath>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '%(Identity)'))</DorotiFullPath>
      <DorotiAssemblyIdentity Condition="'%(AssemblyName)' == ''">%(Filename)</DorotiAssemblyIdentity>
      <DorotiAssemblyIdentity Condition="'%(AssemblyName)' != ''">%(AssemblyName)</DorotiAssemblyIdentity>
    </DorotiNativeBindingProject>
    <ProjectReference Include="$(DorotiAppProject)" ReferenceOutputAssembly="true" GlobalPropertiesToRemove="TargetFramework;TargetFrameworks;RuntimeIdentifier;RuntimeIdentifiers;DorotiTarget;DorotiHostKind;DorotiNativeEntryKind" />
    <ProjectReference Include="@(DorotiNativeBindingProject)" ReferenceOutputAssembly="true">
      <DorotiNativeBinding>true</DorotiNativeBinding>
      <GlobalPropertiesToRemove>DorotiTarget;DorotiHostKind;DorotiNativeEntryKind</GlobalPropertiesToRemove>
      <AdditionalProperties Condition="'$(DorotiProviderReferenceProperties)' != ''">%(ProjectReference.AdditionalProperties);$(DorotiProviderReferenceProperties)</AdditionalProperties>
    </ProjectReference>
    <Compile Include="*.cs" Exclude="$(DorotiCompileExclude)" />
    <Compile Include="src/**/*.cs" />
    <Compile Include="$(_DorotiBootstrapFile)" AutoGen="true" DesignTime="true" Visible="false" />
    <Compile Include="$(_DorotiPluginRegistrationFile)" AutoGen="true" DesignTime="true" Visible="false" />
    <Compile Include="$(_DorotiNativePluginRegistrationFile)" AutoGen="true" DesignTime="true" Visible="false" />
    <ApplicationDefinition Include="App.xaml" Generator="MSBuild:Compile" Condition="Exists('App.xaml')" />
    <EmbeddedResource Include="application-manifest.$(RuntimeIdentifier).json" LogicalName="Doroti.Application.Manifest" Condition="Exists('application-manifest.$(RuntimeIdentifier).json')" />
    <EmbeddedResource Include="application-manifest.json" LogicalName="Doroti.Application.Manifest" Condition="!Exists('application-manifest.$(RuntimeIdentifier).json') and Exists('application-manifest.json')" />
  </ItemGroup>
  <Target Name="ValidateDorotiRunnerProperties" BeforeTargets="Restore">
    <Error Code="DOROTIDESKTOP003" Condition="'$(DorotiDesktopProject)' != '' and ('$(DorotiDesktopStartupType)' == '' or !Exists('$(DorotiDesktopProject)'))" Text="DorotiDesktopProject requires an existing companion project and DorotiDesktopStartupType." />
    <Error Code="DOROTIAPP201" Condition="'$(DorotiAppProject)' == '' or !Exists('$(DorotiAppProject)')" Text="DorotiAppProject must resolve to an existing platform-neutral application project; found '$(DorotiAppProject)'." />
    <Error Code="DOROTIAPP202" Condition="'$(DorotiTarget)' == '' or '$(DorotiHostKind)' == '' or '$(DorotiNativeEntryKind)' == ''" Text="A Doroti runner must declare DorotiTarget, DorotiHostKind, and DorotiNativeEntryKind." />
    <Error Code="DOROTIAPP203" Condition="'$(TargetFramework)' == '' or '$(RuntimeIdentifier)' == ''" Text="A Doroti runner must declare a fixed TargetFramework and RuntimeIdentifier." />
    <Error Code="DOROTIRUNNER301" Condition="'$(_DorotiExpectedNativeBindingTfm)' != '' and '@(DorotiNativeBindingProject-&gt;Count())' != '1'" Text="The $(DorotiTarget) runner requires exactly one DorotiNativeBindingProject; found '@(DorotiNativeBindingProject-&gt;Count())'." />
    <Error Code="DOROTIRUNNER302" Condition="'$(DorotiProviderSuppliesBootstrap)' == 'true' and '$(_DorotiExpectedNativeBindingTfm)' == '' and '@(DorotiNativeBindingProject)' != ''" Text="The $(DorotiTarget) runner cannot reference a platform native binding project." />
    <Error Code="DOROTIRUNNER303" Condition="'%(DorotiNativeBindingProject.Identity)' != '' and !Exists('%(DorotiNativeBindingProject.DorotiFullPath)')" Text="Doroti native binding project does not exist: %(DorotiNativeBindingProject.Identity)." />
    <Error Code="DOROTIRUNNER304" Condition="'%(DorotiNativeBindingProject.Identity)' != '' and !$([System.String]::Copy('%(DorotiNativeBindingProject.DorotiFullPath)').StartsWith('$(_DorotiRunnerWorkspaceDirectory)', System.StringComparison.OrdinalIgnoreCase))" Text="Doroti native binding project must stay inside its runner workspace '$(_DorotiRunnerWorkspaceDirectory)': %(DorotiNativeBindingProject.DorotiFullPath)." />
  </Target>
  <Target Name="ResolveDorotiNativeBindingContract" Condition="'@(DorotiNativeBindingProject)' != ''" DependsOnTargets="ValidateDorotiRunnerProperties" BeforeTargets="ValidateDorotiRunner">
    <MSBuild Projects="@(DorotiNativeBindingProject)" Targets="GetDorotiNativeBindingContract" Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier)" RemoveProperties="DorotiTarget;DorotiHostKind;DorotiNativeEntryKind" BuildInParallel="false">
      <Output TaskParameter="TargetOutputs" ItemName="_DorotiNativeBindingContract" />
    </MSBuild>
    <RemoveDuplicates Inputs="@(DorotiNativeBindingProject-&gt;'%(DorotiFullPath)')">
      <Output TaskParameter="Filtered" ItemName="_DorotiDistinctNativeBindingPath" />
    </RemoveDuplicates>
    <RemoveDuplicates Inputs="@(DorotiNativeBindingProject-&gt;'%(DorotiAssemblyIdentity)')">
      <Output TaskParameter="Filtered" ItemName="_DorotiDistinctNativeBindingAssembly" />
    </RemoveDuplicates>
    <PropertyGroup>
      <_DorotiNativeBindingCount>@(DorotiNativeBindingProject-&gt;Count())</_DorotiNativeBindingCount>
      <_DorotiNativeBindingContractCount>@(_DorotiNativeBindingContract-&gt;Count())</_DorotiNativeBindingContractCount>
      <_DorotiDistinctNativeBindingPathCount>@(_DorotiDistinctNativeBindingPath-&gt;Count())</_DorotiDistinctNativeBindingPathCount>
      <_DorotiDistinctNativeBindingAssemblyCount>@(_DorotiDistinctNativeBindingAssembly-&gt;Count())</_DorotiDistinctNativeBindingAssemblyCount>
    </PropertyGroup>
    <Error Code="DOROTIRUNNER305" Condition="'$(_DorotiNativeBindingContractCount)' != '$(_DorotiNativeBindingCount)'" Text="Every DorotiNativeBindingProject must expose exactly one GetDorotiNativeBindingContract result; expected '$(_DorotiNativeBindingCount)', found '$(_DorotiNativeBindingContractCount)'." />
    <Error Code="DOROTIRUNNER306" Condition="'$(_DorotiDistinctNativeBindingPathCount)' != '$(_DorotiNativeBindingCount)'" Text="DorotiNativeBindingProject contains a duplicate project path." />
    <Error Code="DOROTIRUNNER307" Condition="'$(_DorotiDistinctNativeBindingAssemblyCount)' != '$(_DorotiNativeBindingCount)'" Text="DorotiNativeBindingProject contains a duplicate assembly identity." />
    <Error Code="DOROTIRUNNER308" Condition="'%(_DorotiNativeBindingContract.NativeTarget)' != '$(DorotiTarget)' or '%(_DorotiNativeBindingContract.TargetFramework)' != '$(_DorotiExpectedNativeBindingTfm)'" Text="Native binding target/TFM is incompatible with the runner. Runner='$(DorotiTarget)|$(TargetFramework)', binding='%(_DorotiNativeBindingContract.NativeTarget)|%(_DorotiNativeBindingContract.TargetFramework)' (%(_DorotiNativeBindingContract.Identity))." />
    <Error Code="DOROTIRUNNER309" Condition="'%(_DorotiNativeBindingContract.NativeBuildItem)' != '$(_DorotiExpectedNativeBuildItem)' or '%(_DorotiNativeBindingContract.NativeProject)' == '' or !Exists('%(_DorotiNativeBindingContract.NativeProject)')" Text="Native binding must expose an existing $(_DorotiExpectedNativeBuildItem) project; found '%(_DorotiNativeBindingContract.NativeBuildItem)|%(_DorotiNativeBindingContract.NativeProject)'." />
  </Target>
  <Target Name="ResolveDorotiApplicationContract" BeforeTargets="ValidateDorotiRunner" Condition="Exists('$(DorotiAppProject)')">
    <MSBuild Projects="$(DorotiAppProject)" Targets="GetDorotiApplicationContract" Properties="Configuration=$(Configuration)" RemoveProperties="TargetFramework;TargetFrameworks;RuntimeIdentifier;RuntimeIdentifiers;DorotiTarget;DorotiHostKind;DorotiNativeEntryKind" BuildInParallel="false">
      <Output TaskParameter="TargetOutputs" ItemName="_DorotiApplicationContract" />
    </MSBuild>
  </Target>
  <Target Name="ValidateDorotiRunner" DependsOnTargets="ValidateDorotiRunnerProperties;ResolveDorotiApplicationContract;ResolveDorotiNativeBindingContract" BeforeTargets="PrepareForBuild">
    <Error Code="DOROTIDESKTOP002" Condition="'$(DorotiDesktopStartupType)' != '' and '$(DorotiProviderSupportsDesktop)' != 'true'" Text="The resolved provider profile does not support a desktop companion." />
    <PropertyGroup>
      <_DorotiTargetDescriptorCount>@(DorotiTargetDescriptor-&gt;Count())</_DorotiTargetDescriptorCount>
      <_DorotiSelectedTarget>@(DorotiTargetDescriptor-&gt;'%(Identity)')</_DorotiSelectedTarget>
      <_DorotiSelectedTfm>@(DorotiTargetDescriptor-&gt;'%(TargetFramework)')</_DorotiSelectedTfm>
      <_DorotiSelectedRid>@(DorotiTargetDescriptor-&gt;'%(RuntimeIdentifier)')</_DorotiSelectedRid>
      <_DorotiSelectedHost>@(DorotiTargetDescriptor-&gt;'%(HostKind)')</_DorotiSelectedHost>
      <_DorotiSelectedEntry>@(DorotiTargetDescriptor-&gt;'%(NativeEntryKind)')</_DorotiSelectedEntry>
      <_DorotiApplicationCount>@(_DorotiApplicationContract-&gt;WithMetadataValue('Kind', 'Application')-&gt;Count())</_DorotiApplicationCount>
      <_DorotiApplicationTfm>@(_DorotiApplicationContract-&gt;WithMetadataValue('Kind', 'Application')-&gt;'%(TargetFramework)')</_DorotiApplicationTfm>
    </PropertyGroup>
    <ItemGroup>
      <_DorotiUnexpectedCompile Include="@(Compile)" Condition="$([System.String]::Copy('%(Compile.FullPath)').StartsWith('$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)'))', System.StringComparison.OrdinalIgnoreCase)) == 'false' and                      '%(Compile.AutoGen)' != 'true'" />
      <_DorotiDisallowedXaml Include="@(ApplicationDefinition)" Condition="'%(ApplicationDefinition.Filename)%(ApplicationDefinition.Extension)' != 'App.xaml'" />
      <_DorotiManifest Include="@(EmbeddedResource)" Condition="'%(EmbeddedResource.LogicalName)' == 'Doroti.Application.Manifest'" />
      <_DorotiDuplicateLogicalAsset Include="@(EmbeddedResource)" Condition="'%(EmbeddedResource.LogicalName)' != ''" />
      <_DorotiManualNativeBindingReference Include="@(ProjectReference)" Condition="'%(ProjectReference.DorotiNativeBinding)' != 'true' and                      @(DorotiNativeBindingProject-&gt;AnyHaveMetadataValue('DorotiFullPath', '%(ProjectReference.FullPath)'))" />
    </ItemGroup>
    <Error Code="DOROTIAPP204" Condition="'$(_DorotiTargetDescriptorCount)' != '1'" Text="A Doroti runner requires exactly one DorotiTargetDescriptor; found '$(_DorotiTargetDescriptorCount)'." />
    <Error Code="DOROTIAPP205" Condition="'$(_DorotiSelectedTarget)' != '$(DorotiTarget)' or '$(_DorotiSelectedTfm)' != '$(TargetFramework)' or '$(_DorotiSelectedRid)' != '$(RuntimeIdentifier)'" Text="Runner target/TFM/RID does not match its descriptor. Runner='$(DorotiTarget)|$(TargetFramework)|$(RuntimeIdentifier)', descriptor='$(_DorotiSelectedTarget)|$(_DorotiSelectedTfm)|$(_DorotiSelectedRid)'." />
    <Error Code="DOROTIAPP206" Condition="'$(_DorotiSelectedHost)' != '$(DorotiHostKind)' or '$(_DorotiSelectedEntry)' != '$(DorotiNativeEntryKind)'" Text="Runner host/entry kind does not match its descriptor. Runner='$(DorotiHostKind)|$(DorotiNativeEntryKind)', descriptor='$(_DorotiSelectedHost)|$(_DorotiSelectedEntry)'." />
    <Error Code="DOROTIAPP207" Condition="'$(_DorotiApplicationCount)' != '1' or '$(_DorotiApplicationTfm)' != 'net10.0'" Text="DorotiAppProject must expose exactly one net10.0 application contract; found count='$(_DorotiApplicationCount)', TFM='$(_DorotiApplicationTfm)'." />
    <Error Code="DOROTIAPP208" Condition="'@(_DorotiUnexpectedCompile)' != ''" Text="A runner cannot compile source outside its own platform directory: @(_DorotiUnexpectedCompile)." />
    <Error Code="DOROTIAPP209" Condition="'@(_DorotiDisallowedXaml)' != ''" Text="Only the runner-owned App.xaml ApplicationDefinition is allowed: @(_DorotiDisallowedXaml)." />
    <Error Code="DOROTIAPP210" Condition="'@(_DorotiManifest-&gt;Count())' != '1'" Text="A runner requires exactly one Doroti.Application.Manifest resource; found '@(_DorotiManifest-&gt;Count())'." />
    <Error Code="DOROTIRUNNER310" Condition="'@(_DorotiManualNativeBindingReference)' != ''" Text="Declare a native binding only with DorotiNativeBindingProject; remove the duplicate ProjectReference: @(_DorotiManualNativeBindingReference)." />
  </Target>
  <Target Name="GenerateDorotiRunnerBootstrap" DependsOnTargets="ValidateDorotiRunner" BeforeTargets="PrepareForBuild;CoreCompile">
    <Error Code="DOROTIPROVIDER001" Condition="'$(DorotiProviderSuppliesBootstrap)' != 'true'" Text="The selected provider must supply its bootstrap assets through DorotiProviderBootstrapTargets." />
    <MakeDir Directories="$(_DorotiGeneratedDirectory)" />
    <ItemGroup>
      <_DorotiPluginLines Include="// &lt;auto-generated /&gt;" />
      <_DorotiPluginLines Include="namespace Doroti.Generated%3B" />
      <_DorotiPluginLines Include="internal static class DorotiPluginRegistration" />
      <_DorotiPluginLines Include="{" />
      <_DorotiPluginLines Include="    internal static readonly global::Doroti.Hosting.DorotiApplicationPluginRegistration[] Items =" />
      <_DorotiPluginLines Include="    [" />
      <_DorotiPluginLines Include="@(DorotiJavaScriptPlugin-&gt;'        new global::Doroti.Hosting.DorotiApplicationPluginRegistration(&quot;%(Identity)&quot;, &quot;%(Channel)&quot;, &quot;doroti.browser-js-plugin/v1&quot;, &quot;%(ModuleUrl)&quot;, &quot;%(ExportName)&quot;),')" />
      <_DorotiPluginLines Include="    ]%3B" />
      <_DorotiPluginLines Include="}" />
      <_DorotiBootstrapLines Include="// &lt;auto-generated /&gt;" />
      <_DorotiBootstrapLines Include="namespace Doroti.Generated%3B" />
      <_DorotiBootstrapLines Include="internal static partial class DorotiBootstrap" />
      <_DorotiBootstrapLines Include="{" />
      <_DorotiBootstrapLines Include="    internal static global::Doroti.Hosting.DorotiApplicationDescriptor Create(string[] args) =&gt;" />
      <_DorotiBootstrapLines Include="        global::Doroti.Desktop.DesktopApplication.Configure&lt;global::$(DorotiDesktopStartupType)&gt;(" Condition="'$(DorotiDesktopStartupType)' != ''" />
      <_DorotiBootstrapLines Include="        global::Doroti.Hosting.DorotiApplicationFactory.Create&lt;global::$(DorotiApplicationType)&gt;(" />
      <_DorotiBootstrapLines Include="            global::Doroti.Hosting.DorotiLaunchContext.Create(&quot;$(DorotiTarget)&quot;, &quot;$(RuntimeIdentifier)&quot;, args), DorotiPluginRegistration.Items, typeof(DorotiBootstrap).Assembly, DorotiNativePluginRegistration.Items)%3B" Condition="'$(DorotiDesktopStartupType)' == ''" />
      <_DorotiBootstrapLines Include="            global::Doroti.Hosting.DorotiLaunchContext.Create(&quot;$(DorotiTarget)&quot;, &quot;$(RuntimeIdentifier)&quot;, args), DorotiPluginRegistration.Items, typeof(DorotiBootstrap).Assembly, DorotiNativePluginRegistration.Items))%3B" Condition="'$(DorotiDesktopStartupType)' != ''" />
      <_DorotiBootstrapLines Include="@(DorotiProviderEntryLine)" />
      <_DorotiBootstrapLines Include="}" />
      <_DorotiNativePluginLines Include="// &lt;auto-generated /&gt;" />
      <_DorotiNativePluginLines Include="namespace Doroti.Generated%3B" />
      <_DorotiNativePluginLines Include="internal static class DorotiNativePluginRegistration" />
      <_DorotiNativePluginLines Include="{" />
      <_DorotiNativePluginLines Include="    internal static readonly global::Doroti.Hosting.IDorotiNativePluginHandler[] Items =" />
      <_DorotiNativePluginLines Include="    [" />
      <_DorotiNativePluginLines Include="@(DorotiNativePlugin-&gt;'        new global::%(HandlerType)(),')" />
      <_DorotiNativePluginLines Include="        new global::$(RootNamespace).DorotiNativePlatformBridge()," Condition="'@(DorotiNativeBindingProject)' != ''" />
      <_DorotiNativePluginLines Include="    ]%3B" />
      <_DorotiNativePluginLines Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(_DorotiPluginRegistrationFile)" Overwrite="true" WriteOnlyWhenDifferent="true" Lines="@(_DorotiPluginLines)" />
    <WriteLinesToFile File="$(_DorotiBootstrapFile)" Overwrite="true" WriteOnlyWhenDifferent="true" Lines="@(_DorotiBootstrapLines)" />
    <WriteLinesToFile File="$(_DorotiNativePluginRegistrationFile)" Overwrite="true" WriteOnlyWhenDifferent="true" Lines="@(_DorotiNativePluginLines)" />
    <ItemGroup>
      <FileWrites Include="$(_DorotiBootstrapFile);$(_DorotiPluginRegistrationFile);$(_DorotiNativePluginRegistrationFile)" />
    </ItemGroup>
  </Target>
  <Target Name="WriteDorotiTargetGraph" DependsOnTargets="GenerateDorotiRunnerBootstrap">
    <ItemGroup>
      <_DorotiGraphLine Include="applicationProject=$(DorotiAppProject)" />
      <_DorotiGraphLine Include="runnerProject=$(MSBuildProjectFullPath)" />
      <_DorotiGraphLine Include="target=$(DorotiTarget)" />
      <_DorotiGraphLine Include="host=$(DorotiHostKind)" />
      <_DorotiGraphLine Include="entry=$(DorotiNativeEntryKind)" />
      <_DorotiGraphLine Include="tfm=$(TargetFramework)" />
      <_DorotiGraphLine Include="rid=$(RuntimeIdentifier)" />
      <_DorotiGraphLine Include="startup=$(DorotiApplicationType)" />
      <_DorotiGraphLine Include="descriptor=%(DorotiTargetDescriptor.Identity)|%(DorotiTargetDescriptor.HostKind)|%(DorotiTargetDescriptor.NativeEntryKind)|%(DorotiTargetDescriptor.TargetPackage)" />
      <_DorotiGraphLine Include="binding=%(DorotiNativeBindingProject.Identity)" />
      <_DorotiGraphLine Include="bindingContract=%(_DorotiNativeBindingContract.Identity)|%(_DorotiNativeBindingContract.NativeTarget)|%(_DorotiNativeBindingContract.TargetFramework)|%(_DorotiNativeBindingContract.AssemblyName)" />
      <_DorotiGraphLine Include="nativeProject=%(_DorotiNativeBindingContract.NativeBuildItem)|%(_DorotiNativeBindingContract.NativeProject)|%(_DorotiNativeBindingContract.Configuration)|%(_DorotiNativeBindingContract.ModuleName)|%(_DorotiNativeBindingContract.SchemeName)|%(_DorotiNativeBindingContract.ToolchainVersion)" />
      <_DorotiGraphLine Include="generatedBootstrap=$(_DorotiBootstrapFile)" />
      <_DorotiGraphLine Include="generatedPluginRegistration=$(_DorotiPluginRegistrationFile)" />
    </ItemGroup>
    <WriteLinesToFile File="$(BaseIntermediateOutputPath)doroti-target-graph.txt" Overwrite="true" WriteOnlyWhenDifferent="true" Lines="@(_DorotiGraphLine)" />
  </Target>
  <Target Name="DorotiExcludeReleasePublishSymbols" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release' and '$(DorotiProviderExcludePublishSymbols)' == 'true'">
    <ItemGroup>
      <_DorotiReleasePublishSymbol Include="$(PublishDir)**/*.pdb" />
    </ItemGroup>
    <Delete Files="@(_DorotiReleasePublishSymbol)" />
  </Target>
  <Target Name="GetDorotiPlatformContract" Returns="@(_DorotiPlatformContract)">
    <Error Code="DOROTIPROVIDER002" Condition="'@(DorotiTargetDescriptor-&gt;Count())' != '1' or '$(DorotiProviderId)' == '' or '$(DorotiProviderProtocolVersion)' != '1'" Text="Exactly one target descriptor and a provider protocol v1 contract are required." />
    <ItemGroup>
      <_DorotiPlatformContract Include="$(MSBuildProjectFullPath)" Provider="$(DorotiProviderId)" ProviderVersion="$(DorotiProviderVersion)" CoreRange="$(DorotiProviderCoreRange)" ProtocolVersion="$(DorotiProviderProtocolVersion)" Profile="$(DorotiProviderProfile)" TargetId="$(DorotiTarget)" TargetPackage="@(DorotiTargetDescriptor-&gt;'%(TargetPackage)')" Backend="$(DorotiHostKind)" TargetFramework="$(TargetFramework)" RuntimeIdentifier="$(RuntimeIdentifier)" ToolPackage="$(DorotiProviderToolPackage)" BootstrapAssets="$(DorotiProviderBootstrapTargets)" />
    </ItemGroup>
  </Target>
</Project>
