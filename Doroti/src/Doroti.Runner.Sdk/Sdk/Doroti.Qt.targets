<Project>
  <PropertyGroup Condition="'$(DorotiHostKind)' == 'Qt'">
    <DorotiBuildQtNative Condition="'$(DorotiBuildQtNative)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">true</DorotiBuildQtNative>
    <DorotiQtNativeBuildDirectory Condition="'$(DorotiQtNativeBuildDirectory)' == ''">$(BaseIntermediateOutputPath)$(Configuration)/qt-native</DorotiQtNativeBuildDirectory>
  </PropertyGroup>
  <Target Name="ValidateDorotiQtPublishMode" BeforeTargets="PrepareForBuild;PrepareForPublish"
          Condition="'$(DorotiHostKind)' == 'Qt'">
    <Error Code="DOROTIQT001" Condition="'$(PublishTrimmed)' == 'true' or '$(PublishSingleFile)' == 'true'"
           Text="Qt official Graphite requires the original SkiaSharp managed assembly and a separate native library for package provenance. PublishTrimmed and PublishSingleFile are not supported; use an untrimmed framework-dependent or self-contained publish." />
  </Target>
  <!-- CMake owns dependency/toolchain discovery and its incremental native graph.
       Keep configuration outputs separate and do not replace it with an mtime stamp. -->
  <Target Name="BuildDorotiQtNative" BeforeTargets="Build"
          Condition="'$(DorotiHostKind)' == 'Qt' and '$(DorotiBuildQtNative)' == 'true'">
    <MakeDir Directories="$(DorotiQtNativeBuildDirectory)" />
    <Exec Command="cmake -S &quot;$(MSBuildProjectDirectory)/native&quot; -B &quot;$(DorotiQtNativeBuildDirectory)&quot; -DCMAKE_BUILD_TYPE=$(Configuration)" Timeout="1200000" />
    <PropertyGroup>
      <_DorotiQtCleanFirst Condition="'$(DorotiRebuildDependencies)' == 'true'">--clean-first</_DorotiQtCleanFirst>
    </PropertyGroup>
    <Exec Command="cmake --build &quot;$(DorotiQtNativeBuildDirectory)&quot; --config $(Configuration) $(_DorotiQtCleanFirst)" Timeout="1200000" />
  </Target>
  <Target Name="CopyDorotiQtNative" AfterTargets="Build;Publish"
          Condition="'$(DorotiHostKind)' == 'Qt' and Exists('$(DorotiQtNativeBuildDirectory)/libdoroti_qt_host.so')">
    <!-- Equal length/mtime does not imply equal native code (restored artifacts
         can preserve both). Always copy the library selected by this build. -->
    <Copy SourceFiles="$(DorotiQtNativeBuildDirectory)/libdoroti_qt_host.so" DestinationFolder="$(TargetDir)" />
    <Copy SourceFiles="$(DorotiQtNativeBuildDirectory)/libdoroti_qt_host.so" DestinationFolder="$(PublishDir)" Condition="'$(PublishDir)' != ''" />
  </Target>
</Project>
