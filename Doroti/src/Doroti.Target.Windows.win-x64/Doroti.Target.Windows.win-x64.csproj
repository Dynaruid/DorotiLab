<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Doroti.Host.Windows</AssemblyName>
    <RootNamespace>Doroti.Target.Windows</RootNamespace>
    <PackageId>Doroti.Target.Windows.win-x64</PackageId>
    <Description>Doroti source-ported Win32/WGL Flutter host and diagnostic contract for win-x64.</Description>
    <IsDorotiProduct>true</IsDorotiProduct>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Doroti.Flutter.Hosting\Doroti.Flutter.Hosting.csproj" />
    <ProjectReference Include="..\Doroti.Flutter.Ui\Doroti.Flutter.Ui.csproj" />
    <ProjectReference Include="..\Doroti.Host.Desktop\Doroti.Host.Desktop.csproj" />
    <ProjectReference Include="..\Doroti.Host.Desktop.Flutter\Doroti.Host.Desktop.Flutter.csproj" />
    <ProjectReference Include="..\Doroti.Platform\Doroti.Platform.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="doroti-target-manifest.json" LogicalName="Doroti.Target.Manifest" />
    <None Include="doroti-target-manifest.json" Pack="true" PackagePath="doroti/" />
    <None Include="..\..\migration\avalonia-shell\port-selection.json"
          Link="source-port/port-selection.json" Pack="true" PackagePath="source-port/" />
    <None Include="..\..\migration\avalonia-shell\g5-6w-source-port-provenance.json"
          Link="source-port/provenance.json" Pack="true" PackagePath="source-port/provenance.json" />
  </ItemGroup>
</Project>
