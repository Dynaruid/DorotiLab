    <None Update="Assets\CupertinoIcons_LICENSE.txt" Pack="true" PackagePath="licenses\CupertinoIcons_LICENSE.txt" />
    <None Update="Assets\MaterialIcons_LICENSE.txt" Pack="true" PackagePath="licenses\MaterialIcons_LICENSE.txt" />
