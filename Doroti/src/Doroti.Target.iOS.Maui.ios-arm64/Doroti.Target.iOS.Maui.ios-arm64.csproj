<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <TargetFramework Condition="'$(DorotiIosTargetFramework)' != ''">$(DorotiIosTargetFramework)</TargetFramework>
    <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
    <AssemblyName>Doroti.Target.iOS.Maui</AssemblyName>
    <RootNamespace>Doroti.Target.iOS.Maui</RootNamespace>
    <PackageId>Doroti.Target.iOS.Maui.ios-arm64</PackageId>
    <Description>Doroti UIKit SKMetalView MAUI composition root for iOS arm64.</Description>
    <IsDorotiProduct>true</IsDorotiProduct>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <EnableDefaultMauiItems>false</EnableDefaultMauiItems>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Doroti.Host.Maui\Doroti.Host.Maui.csproj" AdditionalProperties="RuntimeIdentifier=ios-arm64" />
    <EmbeddedResource Include="doroti-target-manifest.json" LogicalName="Doroti.Target.Manifest" Condition="'$(TargetFramework)' == 'net10.0-ios'" />
    <EmbeddedResource Include="doroti-target-manifest.net11.json" LogicalName="Doroti.Target.Manifest" Condition="'$(TargetFramework)' == 'net11.0-ios'" />
    <None Include="doroti-target-manifest.json" Pack="true" PackagePath="doroti\" Condition="'$(TargetFramework)' == 'net10.0-ios'" />
    <None Include="doroti-target-manifest.net11.json" Pack="true" PackagePath="doroti/doroti-target-manifest.json" Condition="'$(TargetFramework)' == 'net11.0-ios'" />
    <None Include="buildTransitive\Doroti.Target.iOS.Maui.ios-arm64.targets" Pack="true" PackagePath="buildTransitive\Doroti.Target.iOS.Maui.ios-arm64.targets" />
  </ItemGroup>
</Project>
