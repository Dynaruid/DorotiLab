<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Doroti.Skia.Rendering</AssemblyName>
    <RootNamespace>Doroti.Skia.Rendering</RootNamespace>
    <PackageId>Doroti.Skia.Rendering</PackageId>
    <Description>Host-neutral retained Doroti scene rasterization for Skia surfaces.</Description>
    <IsDorotiProduct>true</IsDorotiProduct>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Doroti.Tests" />
    <EmbeddedResource Include="Shaders\variable_blur.sksl" LogicalName="Doroti.Skia.Rendering.Shaders.variable_blur.sksl" />
    <EmbeddedResource Include="Shaders\kawase_blur.sksl" LogicalName="Doroti.Skia.Rendering.Shaders.kawase_blur.sksl" />
    <EmbeddedResource Include="Shaders\variable_blur_stage.sksl" LogicalName="Doroti.Skia.Rendering.Shaders.variable_blur_stage.sksl" />
    <PackageReference Include="SkiaSharp" />
    <ProjectReference Include="..\Doroti.Skia.RuntimeEffects\Doroti.Skia.RuntimeEffects.csproj" />
    <ProjectReference Include="..\Doroti.Ui\Doroti.Ui.csproj" />
  </ItemGroup>
</Project>
