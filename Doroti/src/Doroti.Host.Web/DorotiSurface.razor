@using Doroti.Hosting
@using Doroti.Ui
@implements IAsyncDisposable
@inject IDorotiBrowserTarget BrowserTarget
@inject HttpClient Http

<main class="doroti-root" data-doroti-host="canvas-only">
    <DorotiWebGlSurface @ref="_skiaSurface" CanvasId="@CanvasId" Paint="PaintSurface"
        CompletePaint="CompleteSurfacePaint" />
    <textarea id="@TextInputId" class="doroti-ime" aria-hidden="true" tabindex="-1" hidden></textarea>
    <div id="@SemanticsId" class="doroti-semantics" role="application" aria-label="@Application.ViewConfiguration.title"></div>
</main>

@code {
    private const ulong ViewId = 7301;
    private const string DefaultFallbackFontUrl =
        "_content/Doroti.Host.Web/fonts/NanumGothic-Regular.ttf";
    private DorotiWebGlSurface? _skiaSurface;
    private IDorotiBrowserTarget? _target;
    private DorotiApplicationBoundary? _boundary;
    private DorotiHostSession? _session;
    private DorotiView? _view;
    private bool _started;

    [Parameter, EditorRequired]
    public required DorotiApplicationDescriptor Application { get; set; }

    private static string CanvasId => "doroti-surface";
    private static string TextInputId => "doroti-ime";
    private static string SemanticsId => "doroti-semantics";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _started) return;
        _started = true;
        await BrowserHostRuntime.EnsureInitializedAsync();
        _target = BrowserTarget;
        var fallbackFont = await Http.GetByteArrayAsync(DefaultFallbackFontUrl);
        _target.RegisterFont(fallbackFont);
        _session = new DorotiHostSession(Application.EntrypointFactory());
        using var dispatcherScope = _session.dispatcher.EnterScope();
        _session.Start(deferFrameworkBootstrap: true);
        var plugins = Application.PluginRegistrations.Select(item => new BrowserJavaScriptPluginDescriptor(
            item.Id, item.Channel, item.Adapter, item.Module, item.ExportName));
        _boundary = _target.LoadApplicationBoundary(Application.ManifestAssembly, Application.ApplicationAssembly, plugins);
        _view = _target.CreateView(_session, ViewId, CanvasId, Application.ViewConfiguration, _boundary);
        _target.AttachSkiaSurface(ViewId, RequestPresent);
        _view.Show();
        _session.dispatcher.setSemanticsTreeEnabled(true);
        // Drain the initial observed target even when the first framework
        // scene was submitted before the owned presenter finished attaching.
        RequestPresent();
    }

    private void RequestPresent()
    {
        if (_target is not null && _skiaSurface is not null)
            _skiaSurface.RequestPresent(_target.CaptureSnapshot(ViewId).ResizeEpoch);
    }

    private string PaintSurface(
        SKSurface surface, int pixelWidth, int pixelHeight, DorotiResizeEpoch target, long requestId)
    {
        if (_target is null) return "superseded";
        return _target.PaintSkiaSurface(ViewId, surface, pixelWidth, pixelHeight, target, requestId);
    }

    private void CompleteSurfacePaint(long requestId, long generation, string terminal, string reason) =>
        _target?.CompleteSkiaSurfacePaint(ViewId, requestId, generation, terminal, reason);

    public ValueTask DisposeAsync()
    {
        using var dispatcherScope = _session?.dispatcher.EnterScope();
        _view?.Dispose();
        _boundary?.Dispose();
        _target?.Dispose();
        _session?.Dispose();
        _view = null;
        _target = null;
        _session = null;
        _boundary = null;
        return ValueTask.CompletedTask;
    }
}
