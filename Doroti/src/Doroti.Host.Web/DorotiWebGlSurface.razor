@using System.Runtime.Versioning
@using System.Runtime.InteropServices
@using Microsoft.JSInterop
@using Doroti.Ui
@using SkiaSharp
@implements IAsyncDisposable
@inject IJSRuntime JS

<canvas id="@CanvasId" tabindex="0" aria-label="Doroti GPU surface"></canvas>

@code {
    private const int ResourceCacheBytes = 256 * 1024 * 1024;
    private IJSObjectReference? _module;
    private DotNetObjectReference<DorotiWebGlSurface>? _self;
    private GRGlInterface? _glInterface;
    private GRContext? _context;
    private GRBackendRenderTarget? _renderTarget;
    private SKSurface? _surface;
    private SKSizeI _surfaceSize;
    private DorotiResizeEpoch? _latestTarget;
    private bool _ready;
    private bool _disposed;

    [Parameter, EditorRequired]
    public required string CanvasId { get; set; }

    [Parameter]
    public Action<SKSurface, int, int, DorotiResizeEpoch>? Paint { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        InterceptBrowserObjects();
        _module = await JS.InvokeAsync<IJSObjectReference>(
            "import", "../_content/Doroti.Host.Web/doroti.web.js");
        _self = DotNetObjectReference.Create(this);
        await _module.InvokeAsync<WebGlInfo>("initializeCanvasPresenter", CanvasId, _self);
        _ready = true;
        if (_latestTarget is { } target) await RequestPresentAsync(target);
    }

    internal async ValueTask RequestPresentAsync(DorotiResizeEpoch target)
    {
        if (_disposed) return;
        _latestTarget = target;
        var module = _module;
        if (!_ready || module is null || target.PhysicalWidth <= 0 || target.PhysicalHeight <= 0) return;
        await module.InvokeVoidAsync("requestPresent", CanvasId, target.Generation,
            target.LogicalWidth, target.LogicalHeight, target.PhysicalWidth,
            target.PhysicalHeight, target.DevicePixelRatio, target.TimestampMicroseconds);
    }

    [JSInvokable]
    public Task RenderFrame(
        long generation,
        double logicalWidth,
        double logicalHeight,
        int physicalWidth,
        int physicalHeight,
        double devicePixelRatio,
        long timestampMicroseconds,
        int framebuffer,
        int stencilBits,
        int sampleCount)
    {
        if (_disposed) return Task.CompletedTask;
        var target = new DorotiResizeEpoch(generation, logicalWidth, logicalHeight,
            physicalWidth, physicalHeight, devicePixelRatio, timestampMicroseconds);
        if (_latestTarget?.Generation != generation) return Task.CompletedTask;
        EnsureSurface(physicalWidth, physicalHeight, framebuffer, stencilBits, sampleCount);
        using (new SKAutoCanvasRestore(_surface!.Canvas, true))
            Paint?.Invoke(_surface, physicalWidth, physicalHeight, target);
        _surface.Canvas.Flush();
        _context!.Flush();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task ContextLost()
    {
        ReleaseGpu();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public async Task ContextRestored()
    {
        if (_latestTarget is { } target) await RequestPresentAsync(target);
    }

    private void EnsureSurface(int width, int height, int framebuffer, int stencilBits, int sampleCount)
    {
        if (_context is null)
        {
            _glInterface = GRGlInterface.Create();
            _context = GRContext.CreateGl(_glInterface)
                ?? throw new InvalidOperationException("Doroti could not create the browser WebGL Skia context.");
            _context.SetResourceCacheLimit(ResourceCacheBytes);
        }
        var size = new SKSizeI(width, height);
        if (_renderTarget is null || _surfaceSize != size || !_renderTarget.IsValid)
        {
            _surface?.Dispose();
            _surface = null;
            _renderTarget?.Dispose();
            var glInfo = new GRGlFramebufferInfo((uint)framebuffer, SKColorType.Rgba8888.ToGlSizedFormat());
            _renderTarget = new GRBackendRenderTarget(width, height, Math.Max(0, sampleCount),
                Math.Max(0, stencilBits), glInfo);
            _surfaceSize = size;
        }
        _surface ??= SKSurface.Create(_context, _renderTarget,
            GRSurfaceOrigin.BottomLeft, SKColorType.Rgba8888)
            ?? throw new InvalidOperationException("Doroti could not wrap the browser WebGL framebuffer.");
    }

    private void ReleaseGpu()
    {
        _surface?.Dispose();
        _surface = null;
        _renderTarget?.Dispose();
        _renderTarget = null;
        _context?.AbandonContext();
        _context?.Dispose();
        _context = null;
        _glInterface?.Dispose();
        _glInterface = null;
        _surfaceSize = SKSizeI.Empty;
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("disposeCanvasPresenter", CanvasId); }
            catch (JSDisconnectedException) { }
        }
        ReleaseGpu();
        _self?.Dispose();
        if (_module is not null) await _module.DisposeAsync();
    }

    private sealed record WebGlInfo(int Context, int FboId, int StencilBits, int SampleCount, int DepthBits);

    // Browser-WASM statically registers native imports under the Skia library name.
    // Keep the Doroti entry point unique while using the same module identity as
    // SkiaSharp.Views.Blazor's upstream InterceptBrowserObjects workaround.
    [DllImport("libSkiaSharp", EntryPoint = "DorotiInterceptBrowserObjects")]
    private static extern void InterceptBrowserObjects();
}
