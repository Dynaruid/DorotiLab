<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <AssemblyName>Doroti.Host.Web</AssemblyName>
    <PackageId>Doroti.Host.Web</PackageId>
    <Description>Doroti browser document, canvas, lifecycle, and requestAnimationFrame host capabilities.</Description>
    <IsDorotiProduct>true</IsDorotiProduct>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp.Views.Blazor" />
    <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" />
    <ProjectReference Include="..\Doroti.Hosting\Doroti.Hosting.csproj" />
    <ProjectReference Include="..\Doroti.Ui\Doroti.Ui.csproj" />
  </ItemGroup>
</Project>
