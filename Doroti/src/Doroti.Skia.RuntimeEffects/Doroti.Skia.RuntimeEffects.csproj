<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Doroti.Skia.RuntimeEffects</AssemblyName>
    <PackageId>Doroti.Skia.RuntimeEffects</PackageId>
    <Description>Shared Skia runtime-effect compiler and GPU image-filter input renderer for Doroti native and Web targets.</Description>
    <PackageReleaseNotes>Uses SkiaSharp 4.154.0 stable and adds bounded same-context GPU capture for ImageFilter.shader implicit child inputs.</PackageReleaseNotes>
    <IsDorotiProduct>true</IsDorotiProduct>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Doroti.Skia.Rendering" />
    <PackageReference Include="SkiaSharp" />
    <ProjectReference Include="..\Doroti.Ui\Doroti.Ui.csproj" />
  </ItemGroup>
</Project>
