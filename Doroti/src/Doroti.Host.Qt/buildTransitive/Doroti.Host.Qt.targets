<Project>
  <!-- Official NativeAssets.Linux is a transitive NuGet dependency. The loader
       validates the final standard library against the pinned package hash. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
    <DorotiLaunchDependency Include="$(TargetDir)libSkiaSharp.so" />
  </ItemGroup>
</Project>
