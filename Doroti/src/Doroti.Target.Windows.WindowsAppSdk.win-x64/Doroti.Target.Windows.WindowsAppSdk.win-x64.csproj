<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\Doroti.Host.WindowsAppSdk.Native\Doroti.NativeVersions.props" />
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>Doroti.Target.Windows.WindowsAppSdk</AssemblyName>
    <RootNamespace>Doroti.Target.Windows.WindowsAppSdk</RootNamespace>
    <PackageId>Doroti.Target.Windows.WindowsAppSdk.win-x64</PackageId>
    <Description>Doroti Windows App SDK 2.4 HwndExactCpp child-HWND target with default Graphite/Vulkan and Windows Presentation.</Description>
    <IsDorotiProduct>true</IsDorotiProduct>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Doroti.Host.WindowsAppSdk\Doroti.Host.WindowsAppSdk.csproj" />
    <EmbeddedResource Include="doroti-target-manifest.json" LogicalName="Doroti.Target.Manifest" />
    <None Include="doroti-target-manifest.json" Pack="true" PackagePath="doroti\" />
    <None Include="buildTransitive\Doroti.Target.Windows.WindowsAppSdk.win-x64.targets"
          Pack="true" PackagePath="buildTransitive\Doroti.Target.Windows.WindowsAppSdk.win-x64.targets" />
    <Content Include="..\Doroti.Host.WindowsAppSdk.Native\bin\Release\x64\doroti_windows_appsdk_host_v1.dll"
             Link="doroti_windows_appsdk_host_v1.dll"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Pack="true"
             PackagePath="runtimes\win-x64\native\doroti_windows_appsdk_host_v1.dll" />
    <Content Include="..\Doroti.Host.WindowsAppSdk.Native\bin\Release\x64\Microsoft.WindowsAppRuntime.Bootstrap.dll"
             Link="Microsoft.WindowsAppRuntime.Bootstrap.dll"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Pack="true"
             PackagePath="runtimes\win-x64\native\Microsoft.WindowsAppRuntime.Bootstrap.dll" />
  </ItemGroup>
  <!-- The source native host is built by a script, outside ProjectReference.
       Declare its external generator/SDK/package inputs for CLI reuse checks. -->
  <ItemGroup>
    <DorotiLaunchDependency Include="$(MSBuildProgramFiles32)\Windows Kits\10\bin\$(DorotiNativeWindowsSdkVersion)\x64\cppwinrt.exe;$(MSBuildProgramFiles32)\Windows Kits\10\UnionMetadata\$(DorotiNativeWindowsSdkVersion)\Windows.winmd" />
    <DorotiLaunchDependency Include="$(NuGetPackageRoot)microsoft.windowsappsdk.interactiveexperiences\$(DorotiNativeInteractiveVersion)\metadata\10.0.18362.0\*.winmd;$(NuGetPackageRoot)microsoft.windowsappsdk.interactiveexperiences\$(DorotiNativeInteractiveVersion)\include\**\*.h" />
    <DorotiLaunchDependency Include="$(NuGetPackageRoot)microsoft.windowsappsdk.foundation\$(DorotiNativeFoundationVersion)\include\**\*.h;$(NuGetPackageRoot)microsoft.windowsappsdk.foundation\$(DorotiNativeFoundationVersion)\lib\native\x64\*.lib;$(NuGetPackageRoot)microsoft.windowsappsdk.foundation\$(DorotiNativeFoundationVersion)\runtimes\win-x64\native\Microsoft.WindowsAppRuntime.Bootstrap.dll" />
    <DorotiLaunchDependency Include="$(NuGetPackageRoot)microsoft.windowsappsdk.runtime\$(DorotiNativeRuntimeVersion)\include\**\*.h" />
  </ItemGroup>
  <Target Name="BuildDorotiWindowsAppSdkNative" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <_DorotiNativeBuildTarget>Build</_DorotiNativeBuildTarget>
      <_DorotiNativeBuildTarget Condition="'$(DorotiRebuildDependencies)' == 'true'">Rebuild</_DorotiNativeBuildTarget>
    </PropertyGroup>
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)\..\..\eng\build-hwnd-exact-cpp-native.ps1&quot; -Target $(_DorotiNativeBuildTarget)" />
  </Target>
</Project>
