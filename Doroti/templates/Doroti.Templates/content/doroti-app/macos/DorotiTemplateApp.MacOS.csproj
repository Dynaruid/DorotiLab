<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Doroti.Runner.Sdk" Version="0.2.0-beta" />
  <PropertyGroup>
    <TargetFramework>net10.0-macos</TargetFramework>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <AssemblyName>DorotiTemplateApp.MacOS</AssemblyName>
    <RootNamespace>DorotiTemplateApp.MacOS</RootNamespace>
    <DorotiAppProject>..\DorotiTemplateApp.csproj</DorotiAppProject>
    <DorotiTarget>macOS</DorotiTarget>
    <DorotiHostKind>Maui</DorotiHostKind>
    <DorotiNativeEntryKind>AppKit-Main</DorotiNativeEntryKind>
    <UseMaui>true</UseMaui>
    <DefineConstants>$(DefineConstants);MACOS;DOROTI_MAUI</DefineConstants>
    <SupportedOSPlatformVersion>14.0</SupportedOSPlatformVersion>
    <ApplicationManifest>Info.MacOS.plist</ApplicationManifest>
    <AppManifest>Info.MacOS.plist</AppManifest>
    <AppBundleManifest>Info.MacOS.plist</AppBundleManifest>
    <ApplicationTitle>DorotiTemplateApp</ApplicationTitle>
    <ApplicationId>__DOROTI_APPLICATION_ID__.macos</ApplicationId>
    <NuGetLockFilePath>packages.macos.lock.json</NuGetLockFilePath>
    <DorotiCompileExclude>AppDelegate.cs;DorotiNativePlatformBridge.cs</DorotiCompileExclude>
  </PropertyGroup>
  <ItemGroup>
    <DorotiNativeBindingProject Include="binding\DorotiTemplateApp.MacOS.Native.csproj" />
    <DorotiTargetDescriptor Include="macOS" HostKind="Maui" NativeEntryKind="AppKit-Main" RuntimeIdentifier="osx-arm64" TargetFramework="net10.0-macos" TargetPackage="Doroti.Target.MacOS.Maui.osx-arm64" />
    <PackageReference Include="Doroti.Target.MacOS.Maui.osx-arm64" Version="0.2.0-beta" />
  </ItemGroup>
</Project>
