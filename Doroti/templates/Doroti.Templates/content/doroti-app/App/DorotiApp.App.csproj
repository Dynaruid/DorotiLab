<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>DorotiApp.App</AssemblyName>
    <RootNamespace>DorotiApp</RootNamespace>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Doroti.Hosting" Version="0.2.0-beta" />
    <PackageReference Include="Doroti.Ui" Version="0.2.0-beta" />
    <PackageReference Include="Doroti.Framework.Widgets" Version="0.2.0-beta" />
    <PackageReference Include="Doroti.Framework.Material" Version="0.2.0-beta" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="application-manifest.json" LogicalName="Doroti.Application.Manifest" />
  </ItemGroup>
</Project>
