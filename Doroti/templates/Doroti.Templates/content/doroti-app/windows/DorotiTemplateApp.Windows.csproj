<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Doroti.Runner.Sdk" Version="0.2.0-beta" />
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <OutputType>WinExe</OutputType>
    <AssemblyName>DorotiTemplateApp.Windows</AssemblyName>
    <RootNamespace>DorotiTemplateApp.WindowsAppSdk</RootNamespace>
    <DorotiAppProject>..\DorotiTemplateApp.csproj</DorotiAppProject>
    <DorotiTarget>Windows</DorotiTarget>
    <DorotiHostKind>WindowsAppSdk</DorotiHostKind>
    <DorotiNativeEntryKind>Win32-WinMain</DorotiNativeEntryKind>
    <DorotiWindowsAdapterDefault>FlutterEmbedder</DorotiWindowsAdapterDefault>
    <UseMaui>false</UseMaui>
    <DefineConstants>$(DefineConstants);WINDOWS;DOROTI_WINDOWS_APPSDK</DefineConstants>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <DorotiTargetDescriptor Include="Windows" HostKind="WindowsAppSdk" NativeEntryKind="Win32-WinMain" RuntimeIdentifier="win-x64" TargetFramework="net10.0-windows10.0.19041.0" TargetPackage="Doroti.Target.Windows.WindowsAppSdk.win-x64" AdapterDefault="$(DorotiWindowsAdapterDefault)" AdapterCapabilities="FlutterEmbedder;ArmNLegacy" SeparateHostRollback="Doroti.Target.Windows.Maui.win-x64" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Doroti.Target.Windows.WindowsAppSdk.win-x64" Version="0.2.0-beta" />
  </ItemGroup>
</Project>
