<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Doroti.Runner.Sdk" Version="0.4.0-alpha.1" />
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>DorotiTemplateApp.Windows.Maui</AssemblyName>
    <RootNamespace>DorotiTemplateApp.WinUI</RootNamespace>
    <DorotiAppProject>../../DorotiTemplateApp.csproj</DorotiAppProject>
    <DorotiDesktopProject>../../desktop/DorotiTemplateApp.Desktop.csproj</DorotiDesktopProject>
    <DorotiDesktopStartupType>DorotiTemplateApp.Desktop.DesktopStartup</DorotiDesktopStartupType>
    <DorotiTarget>Windows</DorotiTarget>
    <DorotiHostKind>Maui</DorotiHostKind>
    <DorotiNativeEntryKind>WinUI-Xaml</DorotiNativeEntryKind>
    <UseMaui>true</UseMaui>
    <DisableMauiImplicitPackageReferences>true</DisableMauiImplicitPackageReferences>
    <DefineConstants>$(DefineConstants);WINDOWS;DOROTI_MAUI</DefineConstants>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <ApplicationManifest>../app.manifest</ApplicationManifest>
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>
  <ItemGroup>
    <DorotiTargetDescriptor Include="Windows" HostKind="Maui" NativeEntryKind="WinUI-Xaml" RuntimeIdentifier="win-x64" TargetFramework="net10.0-windows10.0.19041.0" TargetPackage="Doroti.Target.Windows.Maui.win-x64" />
    <PackageReference Include="Doroti.Target.Windows.Maui.win-x64" Version="0.4.0-alpha.1" />
  </ItemGroup>
</Project>
