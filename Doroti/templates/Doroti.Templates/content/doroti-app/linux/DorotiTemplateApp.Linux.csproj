<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Doroti.Runner.Sdk" Version="0.4.1-beta" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>DorotiTemplateApp.Linux</AssemblyName>
    <RootNamespace>DorotiTemplateApp.Linux</RootNamespace>
    <DorotiAppProject>..\DorotiTemplateApp.csproj</DorotiAppProject>
    <DorotiTarget>Linux</DorotiTarget>
    <DorotiHostKind>Qt</DorotiHostKind>
    <DorotiNativeEntryKind>Qt-Main</DorotiNativeEntryKind>
    <SelfContained>false</SelfContained>
    <!-- Debian packaging is opt-in. Set a unique stable package ID, real
         maintainer and your application's copyright/license file first.
    <DorotiDebPackageId>com-example-myapp</DorotiDebPackageId>
    <DorotiDebMaintainer>Your name &lt;you@example.com&gt;</DorotiDebMaintainer>
    <DorotiDebDescription>My desktop application</DorotiDebDescription>
    <DorotiDebVersion>$(ApplicationDisplayVersion)</DorotiDebVersion>
    <DorotiDebRevision>1</DorotiDebRevision>
    <DorotiDebExcludeLttngProvider>true</DorotiDebExcludeLttngProvider>
    <DorotiDebCopyright>../LICENSE</DorotiDebCopyright>
    <DorotiDebCategories>Utility</DorotiDebCategories>
    -->
    <DorotiQtQuick Condition="'$(DorotiQtQuick)' == ''">true</DorotiQtQuick>
  </PropertyGroup>
  <ItemGroup>
    <DorotiTargetDescriptor Include="Linux" HostKind="Qt" NativeEntryKind="Qt-Main" RuntimeIdentifier="linux-x64" TargetFramework="net10.0" TargetPackage="Doroti.Target.Linux.Qt.linux-x64" />
    <PackageReference Include="Doroti.Target.Linux.Qt.linux-x64" Version="0.4.1-beta" />
  </ItemGroup>
  <ItemGroup><PackageReference Include="Doroti.Tool.Qt" Version="0.4.1-beta" /></ItemGroup>
</Project>
