<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <Sdk Name="Doroti.Runner.Sdk" Version="0.4.0-alpha.1" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <AssemblyName>DorotiTemplateApp.Web</AssemblyName>
    <RootNamespace>DorotiTemplateApp.Web</RootNamespace>
    <DorotiAppProject>..\DorotiTemplateApp.csproj</DorotiAppProject>
    <DorotiTarget>Web</DorotiTarget>
    <DorotiHostKind>BlazorWebAssembly</DorotiHostKind>
    <DorotiNativeEntryKind>Managed-Main</DorotiNativeEntryKind>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <WasmEnableThreads>true</WasmEnableThreads>
    <DefineConstants>$(DefineConstants);DOROTI_BROWSER</DefineConstants>
    <DorotiWebFontPreset Condition="'$(DorotiWebFontPreset)' == ''">Default</DorotiWebFontPreset>
    <DorotiWebFontOptions Condition="'$(DorotiWebFontPreset)' == 'Offline'">global::DorotiTemplateApp.Web.WebFonts.Offline</DorotiWebFontOptions>
  </PropertyGroup>
  <ItemGroup>
    <DorotiTargetDescriptor Include="Web" HostKind="BlazorWebAssembly" NativeEntryKind="Managed-Main" RuntimeIdentifier="browser-wasm" TargetFramework="net10.0" TargetPackage="Doroti.Target.Web.browser-wasm" />
    <PackageReference Include="Doroti.Target.Web.browser-wasm" Version="0.4.0-alpha.1" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.11" PrivateAssets="all" />
    <PackageReference Include="Microsoft.TypeScript.MSBuild" Version="7.0.0" PrivateAssets="all" />
    <DorotiJavaScriptPlugin Include="echo" Channel="doroti.example/echo" ExportName="invoke" ModuleUrl="./plugins/echo.js" />
  </ItemGroup>
  <ItemGroup Condition="'$(DorotiWebFontPreset)' != 'Offline'">
    <Content Remove="wwwroot/fonts/offline/**/*;wwwroot/fonts/decoder/**/*" />
  </ItemGroup>
  <Target Name="ValidateDorotiFontPreset" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(DorotiWebFontPreset)' != 'Default' and '$(DorotiWebFontPreset)' != 'Offline'" Text="DorotiWebFontPreset must be Default or Offline." />
  </Target>
  <ItemGroup><PackageReference Include="Doroti.Tool.Web" Version="0.4.0-alpha.1" /></ItemGroup>
</Project>
