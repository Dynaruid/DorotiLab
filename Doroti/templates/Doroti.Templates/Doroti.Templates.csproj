<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Doroti.Templates</AssemblyName>
    <PackageId>Doroti.Templates</PackageId>
    <IsDorotiProduct>false</IsDorotiProduct>
    <IsPackable>true</IsPackable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Authors>Doroti contributors</Authors>
    <Description>Standard .NET templates for C# Doroti applications.</Description>
    <PackageTags>doroti;templates;blazor;webassembly</PackageTags>
    <PackageType>Template</PackageType>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <IncludeSymbols>false</IncludeSymbols>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="content\doroti-app\**\*"
             Exclude="content\doroti-app\**\bin\**;content\doroti-app\**\obj\**;content\doroti-app\android\native\gradlew"
             Pack="true"
             PackagePath="content\doroti-app\%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="content\doroti-app\android\native\gradlew"
             Pack="true"
             PackagePath="content\doroti-app\android\native" />
  </ItemGroup>
</Project>
