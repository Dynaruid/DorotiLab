<Project>
  <Import Project="../Directory.Build.props" />
  <Import Project="eng/Doroti.Common.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <VersionPrefix>0.4.0</VersionPrefix>
    <VersionSuffix>beta</VersionSuffix>
    <DorotiCoreVersion Condition="'$(DorotiCoreVersion)' == ''">0.4.0-beta</DorotiCoreVersion>
    <Version Condition="'$(Version)' == ''">$(DorotiCoreVersion)</Version>
    <IsPackable>false</IsPackable>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildThisFileDirectory)artifacts\**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
