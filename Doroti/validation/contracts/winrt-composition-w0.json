{
  "schema": "doroti.winrt-composition-w0/v3",
  "status": "required",
  "packagePolicy": {
    "centralMicrosoftWindowsAppSdk": "1.8.260508005",
    "windowsAppSdkHostVersionOverride": "2.4.0",
    "validationPackage": "2.4.0",
    "upgradeOrDowngradeAllowed": false,
    "deployment": "self-contained unpackaged"
  },
  "boundary": {
    "name": "attached HWND shim + ContentIsland",
    "pureWinRt": false,
    "contentAppWindowBridgeRequired": false,
    "contentAppWindowBridgeExpectedAvailable": false,
    "childRenderHwndAllowed": false,
    "productBackendImplementationAllowed": false
  },
  "requiredProjectedApis": [
    "Microsoft.UI.Content.ContentIsland.CreateForSystemVisual",
    "Microsoft.UI.Content.DesktopAttachedSiteBridge.CreateFromWindowId",
    "Microsoft.UI.Content.ContentSiteView.ClientSize",
    "Microsoft.UI.Content.ContentSiteView.ActualSize",
    "Microsoft.UI.Content.ContentSiteView.RasterizationScale",
    "Microsoft.UI.Input.InputPointerSource.GetForIsland",
    "Microsoft.UI.Input.InputKeyboardSource.GetForIsland",
    "Microsoft.UI.Input.InputPreTranslateKeyboardSource.GetForIsland",
    "Microsoft.UI.Input.InputFocusController.GetForIsland",
    "Microsoft.UI.Input.InputActivationListener.GetForWindowId",
    "Microsoft.UI.Content.ContentIsland.AutomationProviderRequested"
  ],
  "requiredAbsentProjectedApis": [
    "Microsoft.UI.Input.InputPointerSource.GetForWindowId",
    "Microsoft.UI.Input.InputKeyboardSource.GetForWindowId",
    "Microsoft.UI.Input.InputPreTranslateKeyboardSource.GetForWindowId",
    "Microsoft.UI.Input.InputFocusController.GetForWindowId"
  ],
  "systemIslandInputOwnership": {
    "desktopAttachedSiteBridgeProcessesPointerInput": false,
    "desktopAttachedSiteBridgeProcessesKeyboardInput": true,
    "rootIslandInputSourceRegistrationAllowed": false,
    "keyboardRuntimeFloor": "bridge-processing-enabled-without-root-input-source-registration",
    "inputActivationListenerRole": "observation-only",
    "packetOwner": "sole-top-level-hwnd-native-ingress",
    "nativeIngressCallsite": "WinRtTopLevelNativeIngress",
    "nativeConfigurationBridge": "bounded-cpp-winrt-diagnostic-only",
    "nativeIngressRule": "normalize-and-enqueue-without-framework-gpu-present-or-commit-wait",
    "keyboardPacketRule": "top-level-wndproc-only-despite-bridge-runtime-floor"
  },
  "nativeInteropAllowlist": [
    "combase.dll!RoInitialize",
    "combase.dll!RoUninitialize",
    "user32.dll!CreateWindowExW",
    "user32.dll!DestroyWindow",
    "user32.dll!GetClientRect",
    "user32.dll!SetWindowPos",
    "user32.dll!DefWindowProcW",
    "user32.dll!DispatchMessageW",
    "user32.dll!GetMessageW",
    "user32.dll!PostMessageW",
    "user32.dll!RegisterClassExW",
    "user32.dll!TranslateMessage",
    "user32.dll!EnableMouseInPointer",
    "user32.dll!GetPointerInfo",
    "user32.dll!GetPointerInfoHistory",
    "user32.dll!SetCapture",
    "user32.dll!ReleaseCapture",
    "user32.dll!GetCapture",
    "user32.dll!ScreenToClient",
    "user32.dll!GetKeyState",
    "user32.dll!LoadCursorW",
    "user32.dll!SetCursor",
    "Doroti.WinRtContentIsland.NativeBridge.dll!DorotiWinRtConfigureDesktopAttachedSiteBridge",
    "imm32.dll!ImmGetContext",
    "imm32.dll!ImmReleaseContext",
    "UIAutomationCore.dll!UiaReturnRawElementProvider",
    "d3d11.dll!D3D11CreateDevice",
    "dxgi.dll!CreateDXGIFactory2",
    "Windows.UI.Composition!ICompositorInterop.CreateCompositionSurfaceForSwapChain"
  ],
  "officialSampleComparison": {
    "repository": "https://github.com/microsoft/WindowsAppSDK-Samples",
    "path": "Samples/Islands/UXFrameworksOnIslands",
    "referenceBranch": "main",
    "referenceCommit": "18431c6d0111d6a4bd8d46b9c8a82add47ccb013",
    "sharedStructure": [
      "one UI-thread Microsoft.UI.Dispatching.DispatcherQueueController",
      "one dedicated Windows.System.DispatcherQueueController for the system compositor",
      "DesktopAttachedSiteBridge attached to a top-level WindowId",
      "system ContentIsland connected to the desktop bridge",
      "ContentSiteView-driven resize and display-scale handling",
      "explicit input focus and accessibility boundaries across nested island frames"
    ],
    "observedDesktopAttachmentInput": [
      "the official TopLevelWindow disables bridge keyboard and pointer processing so input goes to the HWND",
      "the local 2.4 runtime connects successfully with ProcessesPointerInput=false",
      "enabling DesktopAttachedSiteBridge pointer processing did not produce a supported local activation path"
    ],
    "dorotiDifferences": [
      "XAML and mixed UX frameworks are excluded",
      "the target is a Direct3D-backed composition surface",
      "the Windows App SDK package is exact 2.4.0 and self-contained",
      "local projected APIs and runtime activation are authoritative"
    ]
  },
  "baselines": [
    "Doroti/validation/windows-resize-capture",
    "Doroti/validation/windowsappsdk-24-preflight",
    "Doroti/validation/winrt-content-island-native-bridge",
    "Doroti/src/Doroti.Host.WindowsAppSdk/DorotiWindowsAppSdkRunner.cs"
  ]
}
