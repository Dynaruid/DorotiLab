  "protocolMappings": [
    {
      "id": "native-window-tree",
      "referenceAnchors": [
        "host.initialize-view",
        "host.set-child-content",
        "host.resize-child",
        "view.initialize-child",
        "view.window-size"
      ],
      "dorotiRequirement": "One standard top-level HWND owns non-client behavior; one WS_CHILD view HWND fills its client rect and is the native interaction/render boundary."
    },
    {
      "id": "physical-metrics-and-resize",
      "referenceAnchors": [
        "resize.window-size-changed",
        "resize.frame-generated",
        "resize.empty-frame-generated",
        "resize.render-surface"
      ],
      "dorotiRequirement": "Child WM_SIZE physical pixels start an immutable resize generation; only an exact-generation, exact-extent raster frame may recreate the window surface."
    },
    {
      "id": "presented-ack-and-first-frame",
      "referenceAnchors": [
        "resize.frame-presented",
        "resize.dwm-ordering"
      ],
      "dorotiRequirement": "Successful present is the resize terminal and first-frame show boundary; the raster owner performs the post-present DwmFlush ordering point."
    },
    {
      "id": "angle-window-surface",
      "referenceAnchors": [
        "egl.window-surface"
      ],
      "dorotiRequirement": "The Win32 host uses an exact child-HWND ANGLE/EGL window surface, owned and recreated only by the raster thread."
    }
  ],
  "scopeBoundary": "This contract validates a source-only reference. It neither builds nor instruments Flutter, and it does not establish Doroti product, output, or visible acceptance."
