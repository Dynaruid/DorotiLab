<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Doroti.Validation.G6LanguageRuntime</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(G6GeneratedRoot)\Doroti.Generated.Validation.G6LanguageRuntime.csproj"
                      AdditionalProperties="DorotiRepositoryRoot=$(DorotiRepositoryRoot)" />
  </ItemGroup>
  <Target Name="RequireG6GeneratedRoot" BeforeTargets="PrepareForBuild" Condition="'$(G6GeneratedRoot)' == ''">
    <Error Text="G6GeneratedRoot must point to a generated G6 language/runtime candidate." />
  </Target>
</Project>
