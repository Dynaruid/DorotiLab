<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <DorotiVulkanProbePlatform Condition="'$(DorotiVulkanProbePlatform)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">Linux</DorotiVulkanProbePlatform>
    <DorotiVulkanProbePlatform Condition="'$(DorotiVulkanProbePlatform)' == ''">Windows</DorotiVulkanProbePlatform>
    <TargetFramework Condition="'$(DorotiVulkanProbePlatform)' == 'Windows'">net10.0-windows10.0.19041.0</TargetFramework>
    <TargetFramework Condition="'$(DorotiVulkanProbePlatform)' == 'Linux'">net10.0</TargetFramework>
    <RuntimeIdentifier Condition="'$(DorotiVulkanProbePlatform)' == 'Windows'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(DorotiVulkanProbePlatform)' == 'Linux'">linux-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Doroti.Validation.WindowsVulkanCapability</AssemblyName>
    <RootNamespace>Doroti.Validation.WindowsVulkanCapability</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Condition="'$(RuntimeIdentifier)' == 'win-x64'" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Condition="'$(RuntimeIdentifier)' == 'linux-x64'" />
    <PackageReference Include="Silk.NET.Vulkan" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" />
  </ItemGroup>
</Project>
