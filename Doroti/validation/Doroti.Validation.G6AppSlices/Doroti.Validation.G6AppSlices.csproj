<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Doroti.Validation.G6AppSlices</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Doroti.Hosting\Doroti.Hosting.csproj" />
    <ProjectReference Include="..\..\src\Doroti.Backends.Skia\Doroti.Backends.Skia.csproj" />
    <ProjectReference Include="..\..\src\Doroti.Framework.Material\Doroti.Framework.Material.csproj" />
    <ProjectReference Include="..\..\src\Doroti.Target.Windows.win-x64\Doroti.Target.Windows.win-x64.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\g6-slice-asset.txt" LogicalName="G6.AppSlices.Asset" />
    <EmbeddedResource Include="Resources\g6-slice-ko.json" LogicalName="G6.AppSlices.Localization.ko" />
    <EmbeddedResource Include="Resources\g6-reference-traces.json" LogicalName="G6.AppSlices.ReferenceTraces" />
    <EmbeddedResource Include="Resources\application-manifest.json" LogicalName="Doroti.Application.Manifest" />
    <EmbeddedResource Include="$(WINDIR)\Fonts\segoeui.ttf"
                      Condition="Exists('$(WINDIR)\Fonts\segoeui.ttf')"
                      LogicalName="G6.AppSlices.Font.SegoeUI" />
  </ItemGroup>
</Project>
