<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Doroti.Framework.Painting" Version="[0.2.0-beta]" />
    <PackageReference Include="Doroti.Framework.Rendering" Version="[0.2.0-beta]" />
    <PackageReference Include="Doroti.Framework.Semantics" Version="[0.2.0-beta]" />
  </ItemGroup>
</Project>
