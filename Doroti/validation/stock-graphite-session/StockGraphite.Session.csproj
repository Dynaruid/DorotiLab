<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);SHARED_SESSION</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../stock-graphite-vulkan/*.cs" Link="Harness/%(Filename)%(Extension)" />
    <ProjectReference Include="../../src/Doroti.Skia.Vulkan/Doroti.Skia.Vulkan.csproj" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" />
    <PackageReference Include="Silk.NET.Vulkan" />
  </ItemGroup>
</Project>
