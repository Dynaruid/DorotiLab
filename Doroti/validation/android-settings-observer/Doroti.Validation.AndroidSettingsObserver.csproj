<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <ApplicationId>dev.doroti.validation.settingsobserver</ApplicationId>
    <ApplicationTitle>Doroti observer regression</ApplicationTitle>
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
    <PublishTrimmed>true</PublishTrimmed>
    <ObserverSource Condition="'$(ObserverSource)' == ''">../../src/Doroti.Host.Maui/MauiSettingsObserver.Android.cs</ObserverSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ObserverSource)" Link="MauiSettingsObserver.Android.cs" />
  </ItemGroup>
</Project>
