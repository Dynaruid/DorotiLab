<Project>
  <!-- Resolve package/runtime assets without compiling project references. This
       must run after restore; source item lists alone omit the actual DLLs. -->
  <Target Name="DorotiCollectLaunchDependencies" DependsOnTargets="ResolvePackageAssets;ResolveRuntimePackAssets;PrepareProjectReferences"
          Returns="@(_DorotiLaunchDependency)">
    <ItemGroup>
      <_DorotiLaunchDependencyCandidate Include="@(ResolvedCompileFileDefinitions);@(RuntimeCopyLocalItems);@(NativeCopyLocalItems);@(RuntimeTargetsCopyLocalItems);@(ResourceCopyLocalItems);@(RuntimePackAsset);@(NativeFileReference);@(DorotiLaunchDependency);@(Reference->'%(HintPath)');$(ProjectAssetsFile);$(MSBuildAllProjects)" />
      <_DorotiLaunchDependency Include="@(_DorotiLaunchDependencyCandidate->'%(FullPath)')" />
    </ItemGroup>
    <MSBuild Projects="@(_MSBuildProjectReferenceExistent)" Targets="DorotiCollectLaunchDependencies"
             Properties="%(_MSBuildProjectReferenceExistent.SetConfiguration);%(_MSBuildProjectReferenceExistent.SetPlatform);%(_MSBuildProjectReferenceExistent.SetTargetFramework)"
             RemoveProperties="%(_MSBuildProjectReferenceExistent.GlobalPropertiesToRemove)$(_GlobalPropertiesToRemoveFromProjectReferences)"
             BuildInParallel="false" SkipNonexistentProjects="false">
      <Output TaskParameter="TargetOutputs" ItemName="_DorotiLaunchDependency" />
    </MSBuild>
  </Target>
  <Target Name="DorotiCollectLaunchInputs" DependsOnTargets="PrepareProjectReferences" Returns="@(_DorotiLaunchInput)">
    <ItemGroup>
      <_DorotiLaunchInput Include="@(Compile);@(EmbeddedResource);@(Content);@(None);@(AdditionalFiles);$(MSBuildAllProjects)" />
      <_DorotiLaunchInput Include="$(MSBuildProjectFullPath)" />
    </ItemGroup>
    <MSBuild Projects="@(_MSBuildProjectReferenceExistent)" Targets="DorotiCollectLaunchInputs"
             Properties="%(_MSBuildProjectReferenceExistent.SetConfiguration);%(_MSBuildProjectReferenceExistent.SetPlatform);%(_MSBuildProjectReferenceExistent.SetTargetFramework)"
             RemoveProperties="%(_MSBuildProjectReferenceExistent.GlobalPropertiesToRemove)$(_GlobalPropertiesToRemoveFromProjectReferences)"
             BuildInParallel="false" SkipNonexistentProjects="false">
      <Output TaskParameter="TargetOutputs" ItemName="_DorotiLaunchReferencedInput" />
    </MSBuild>
    <ItemGroup>
      <_DorotiLaunchAbsolute Include="@(_DorotiLaunchInput->'%(FullPath)');@(_DorotiLaunchReferencedInput)" />
      <_DorotiLaunchInput Remove="@(_DorotiLaunchInput)" />
      <_DorotiLaunchInput Include="@(_DorotiLaunchAbsolute)" />
    </ItemGroup>
  </Target>
</Project>
