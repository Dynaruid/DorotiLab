<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <Import Project="../../../packages/platforms/build/Sdk.props" />
  <Import Project="../../../Doroti/src/Doroti.Runner.Sdk/Sdk/Sdk.props" />
  <PropertyGroup>
    <TargetFramework>$(DorotiWebTargetFramework)</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <AssemblyName>DorotiDemoApp.Web</AssemblyName>
    <RootNamespace>DorotiDemoApp.Web</RootNamespace>
    <DorotiAppProject>../DorotiDemoApp.csproj</DorotiAppProject>
    <DorotiTarget>Web</DorotiTarget>
    <DorotiHostKind>BlazorWebAssembly</DorotiHostKind>
    <DorotiNativeEntryKind>Managed-Main</DorotiNativeEntryKind>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <WasmBuildNative>true</WasmBuildNative>
    <WasmEnableThreads Condition="'$(WasmEnableThreads)' == ''">true</WasmEnableThreads>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DorotiWebInterpretWidgetTree>true</DorotiWebInterpretWidgetTree>
    <EmccMaximumHeapSize>536870912</EmccMaximumHeapSize>
    <DefineConstants>$(DefineConstants);DOROTI_BROWSER</DefineConstants>
    <DorotiSkiaInteropLibrary>$(MSBuildThisFileDirectory)../../../packages/platforms/web/Doroti.Target.Web.browser-wasm/build/DorotiSkiaInterop.js</DorotiSkiaInteropLibrary>
    <DorotiProviderBootstrapTargets>$(MSBuildProjectDirectory)/../../../packages/platforms/web/bootstrap/Doroti.Provider.Bootstrap.targets</DorotiProviderBootstrapTargets>
  </PropertyGroup>
  <ItemGroup>
    <EmccExportedFunction Include="_wgpuDeviceRelease;_wgpuQueueRelease;_wgpuInstanceRelease" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="$(DorotiWebRuntimeVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="$(DorotiWebRuntimeVersion)" PrivateAssets="all" />
    <PackageReference Include="Microsoft.TypeScript.MSBuild" Version="7.0.1" PrivateAssets="all" />
    <DorotiTargetDescriptor Include="Web" HostKind="BlazorWebAssembly" NativeEntryKind="Managed-Main" RuntimeIdentifier="browser-wasm" TargetFramework="$(TargetFramework)" TargetPackage="Doroti.Target.Web.browser-wasm" />
    <ProjectReference Include="../../../packages/platforms/web/Doroti.Target.Web.browser-wasm/Doroti.Target.Web.browser-wasm.csproj" />
  </ItemGroup>
  <Import Project="../../../Doroti/src/Doroti.Runner.Sdk/Sdk/Sdk.targets" />
</Project>
