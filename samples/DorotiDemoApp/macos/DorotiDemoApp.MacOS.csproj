<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../packages/platforms/build/Sdk.props" />
  <Import Project="../../../Doroti/src/Doroti.Runner.Sdk/Sdk/Sdk.props" />
  <PropertyGroup>
    <DorotiMacOSTargetFramework Condition="'$(DorotiMacOSTargetFramework)' == ''">net10.0-macos</DorotiMacOSTargetFramework>
    <TargetFramework>$(DorotiMacOSTargetFramework)</TargetFramework>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <AssemblyName>DorotiDemoApp.MacOS</AssemblyName>
    <RootNamespace>DorotiDemoApp.MacOS</RootNamespace>
    <DorotiAppProject>..\DorotiDemoApp.csproj</DorotiAppProject>
    <DorotiTarget>macOS</DorotiTarget>
    <DorotiHostKind>Maui</DorotiHostKind>
    <DorotiNativeEntryKind>AppKit-Main</DorotiNativeEntryKind>
    <UseMaui>true</UseMaui>
    <DefineConstants>$(DefineConstants);MACOS;DOROTI_MAUI</DefineConstants>
    <SupportedOSPlatformVersion>14.0</SupportedOSPlatformVersion>
    <ApplicationManifest>Info.MacOS.plist</ApplicationManifest>
    <AppManifest>Info.MacOS.plist</AppManifest>
    <AppBundleManifest>Info.MacOS.plist</AppBundleManifest>
    <ApplicationTitle>Demo (AppKit)</ApplicationTitle>
    <ApplicationId>dev.doroti.demo.macos</ApplicationId>
    <NuGetLockFilePath>packages.macos.lock.json</NuGetLockFilePath>
    <DorotiCompileExclude>AppDelegate.cs;DorotiNativePlatformBridge.cs</DorotiCompileExclude>
    <DorotiProviderBootstrapTargets>$(MSBuildProjectDirectory)/../../../packages/platforms/maui/bootstrap/Doroti.Provider.Bootstrap.targets</DorotiProviderBootstrapTargets>
  </PropertyGroup>
  <ItemGroup>
    <DorotiNativeBindingProject Include="binding\DorotiDemoApp.MacOS.Native.csproj" />
    <DorotiTargetDescriptor Include="macOS" HostKind="Maui" NativeEntryKind="AppKit-Main" RuntimeIdentifier="osx-arm64" TargetFramework="$(DorotiMacOSTargetFramework)" TargetPackage="Doroti.Target.MacOS.Maui.osx-arm64" />
    <ProjectReference Include="../../../packages/platforms/maui/Doroti.Target.MacOS.Maui.osx-arm64/Doroti.Target.MacOS.Maui.osx-arm64.csproj" />
  </ItemGroup>
  <Import Project="../../../Doroti/src/Doroti.Runner.Sdk/Sdk/Sdk.targets" />
</Project>