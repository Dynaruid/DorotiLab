<Project>
  <Import Project="../../Doroti/src/Doroti.App.Sdk/Sdk/Sdk.props" />
  <Import Project="../../tools/Doroti.Localization.Generator/build/Doroti.Localization.Generator.props"
          Condition="'$(DorotiIntlProbe)' == 'localizations'" />
  <PropertyGroup>
    <AssemblyName>DorotiDemoApp</AssemblyName>
    <RootNamespace>DorotiDemoApp</RootNamespace>
    <DorotiUseRepositoryProjects>true</DorotiUseRepositoryProjects>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <PropertyGroup Condition="'$(DorotiIntlProbe)' == 'baseline' or '$(DorotiIntlProbe)' == 'adapter'">
    <DefineConstants>$(DefineConstants);DOROTI_INTL_RENDER_PROBE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(DorotiIntlProbe)' == 'adapter'">
    <DefineConstants>$(DefineConstants);DOROTI_INTL_RENDER_ADAPTER</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(DorotiIntlProbe)' == 'localizations'">
    <DefineConstants>$(DefineConstants);DOROTI_WIDGET_LOCALIZATION_PROBE</DefineConstants>
    <DorotiLocalizationClass>ProbeLocalizations</DorotiLocalizationClass>
    <DorotiLocalizationNamespace>DorotiDemoApp</DorotiLocalizationNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Doroti/src/Doroti.Hosting/Doroti.Hosting.csproj" />
    <ProjectReference Include="../../packages/Doroti.Material/Doroti.Material.csproj" />
    <ProjectReference Include="../../Doroti/src/Doroti.Intl/Doroti.Intl.csproj" Condition="'$(DorotiIntlProbe)' == 'adapter'" />
    <EmbeddedResource Include="assets/fonts/Roboto-*.ttf" LogicalName="MaterialSample.%(Filename)%(Extension)" />
    <EmbeddedResource Include="assets/images/mae-mu-9002s2VnOAY-unsplash.webp" LogicalName="MaterialSample.image.webp" />
    <DorotiLicense Include="src/Components/LICENSE.flutter;assets/fonts/LICENSE.roboto.txt" />
  </ItemGroup>
  <ItemGroup Condition="'$(DorotiIntlProbe)' == 'localizations'">
    <AdditionalFiles Include="l10n/*.arb" />
    <ProjectReference Include="../../packages/Doroti.Localizations.Material/Doroti.Localizations.Material.csproj" />
    <ProjectReference Include="../../tools/Doroti.Localization.Generator/Doroti.Localization.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>
  <Import Project="../../Doroti/src/Doroti.App.Sdk/Sdk/Sdk.targets" />
</Project>
