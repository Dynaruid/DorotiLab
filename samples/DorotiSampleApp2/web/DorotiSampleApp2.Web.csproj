<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <Import Project="..\..\..\Doroti\src\Doroti.Runner.Sdk\Sdk\Sdk.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <AssemblyName>DorotiSampleApp2.Web</AssemblyName>
    <RootNamespace>DorotiSampleApp2.Web</RootNamespace>
    <DorotiAppProject>..\DorotiSampleApp2.csproj</DorotiAppProject>
    <DorotiTarget>Web</DorotiTarget>
    <DorotiHostKind>BlazorWebAssembly</DorotiHostKind>
    <DorotiWebFontOptions>global::DorotiSampleApp2.Web.WebFonts.CdnOptions</DorotiWebFontOptions>
    <DorotiNativeEntryKind>Managed-Main</DorotiNativeEntryKind>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <WasmBuildNative>true</WasmBuildNative>
    <WasmEnableThreads>true</WasmEnableThreads>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);DOROTI_BROWSER</DefineConstants>
    <DorotiSkiaInteropLibrary>$(MSBuildThisFileDirectory)..\..\..\Doroti\src\Doroti.Target.Web.browser-wasm\build\DorotiSkiaInterop.js</DorotiSkiaInteropLibrary>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../DorotiTestbedApp/assets/fonts/Roboto-*.ttf" LogicalName="AssetFonts.%(Filename)%(Extension)" Condition="'$(DorotiSampleWebFontSource)' == 'Assets'" />
    <EmbeddedResource Include="../../DorotiTestbedApp/assets/fonts/LICENSE.roboto.txt" LogicalName="AssetFonts.LICENSE.roboto.txt" Condition="'$(DorotiSampleWebFontSource)' == 'Assets'" />
    <EmccExportedFunction Include="_wgpuDeviceRelease;_wgpuQueueRelease;_wgpuInstanceRelease" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
    <DorotiTargetDescriptor Include="Web" HostKind="BlazorWebAssembly" NativeEntryKind="Managed-Main"
        RuntimeIdentifier="browser-wasm" TargetFramework="net10.0" TargetPackage="Doroti.Target.Web.browser-wasm" />
    <ProjectReference Include="..\..\..\Doroti\src\Doroti.Target.Web.browser-wasm\Doroti.Target.Web.browser-wasm.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.11" PrivateAssets="all" />
    <PackageReference Include="Microsoft.TypeScript.MSBuild" Version="7.0.0" PrivateAssets="all" />
  </ItemGroup>
  <PropertyGroup Condition="'$(DorotiSampleWebFontSource)' == 'Assets'">
    <DorotiWebFontOptions>global::DorotiSampleApp2.Web.WebFonts.Options</DorotiWebFontOptions>
  </PropertyGroup>
  <Import Project="..\..\..\Doroti\src\Doroti.Runner.Sdk\Sdk\Sdk.targets" />
</Project>

