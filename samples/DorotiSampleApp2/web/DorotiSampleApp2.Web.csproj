<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <Import Project="../../../packages/platforms/build/Sdk.props" />
  <Import Project="../../../Doroti/src/Doroti.Runner.Sdk/Sdk/Sdk.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <AssemblyName>DorotiSampleApp2.Web</AssemblyName>
    <RootNamespace>DorotiSampleApp2.Web</RootNamespace>
    <DorotiAppProject>..\DorotiSampleApp2.csproj</DorotiAppProject>
    <DorotiTarget>Web</DorotiTarget>
    <DorotiHostKind>BlazorWebAssembly</DorotiHostKind>
    <DorotiWebFontOptions>global::DorotiSampleApp2.Web.WebFonts.CdnOptions</DorotiWebFontOptions>
    <DorotiNativeEntryKind>Managed-Main</DorotiNativeEntryKind>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <WasmBuildNative>true</WasmBuildNative>
    <WasmEnableThreads>true</WasmEnableThreads>
    <!-- Recursive Cupertino mounting exceeds Safari's Worker stack under full
         AOT. Retain AOT for Skia/interop while interpreting widget/layout code. -->
    <DorotiWebInterpretWidgetTree Condition="'$(DorotiWebInterpretWidgetTree)' == ''">true</DorotiWebInterpretWidgetTree>
    <!-- Keep the sample's shared WASM memory within the mobile-browser budget.
         This is linear memory only; GPU and browser allocations are separate. -->
    <EmccMaximumHeapSize Condition="'$(EmccMaximumHeapSize)' == ''">536870912</EmccMaximumHeapSize>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);DOROTI_BROWSER</DefineConstants>
    <DorotiSkiaInteropLibrary>$(MSBuildThisFileDirectory)..\..\..\packages\platforms\web\Doroti.Target.Web.browser-wasm\build\DorotiSkiaInterop.js</DorotiSkiaInteropLibrary>
    <DorotiProviderBootstrapTargets>$(MSBuildProjectDirectory)/../../../packages/platforms/web/bootstrap/Doroti.Provider.Bootstrap.targets</DorotiProviderBootstrapTargets>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../assets/fonts/**/*" Link="wwwroot/fonts/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Remove="../assets/fonts/CupertinoIcons.*" />
    <Content Remove="../assets/fonts/Galmuri/**/*" Condition="'$(DorotiSampleWebFontSource)' != 'Assets'" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../DorotiTestbedApp/assets/fonts/Roboto-*.ttf" LogicalName="AssetFonts.%(Filename)%(Extension)" Condition="'$(DorotiSampleWebFontSource)' == 'Assets'" />
    <EmbeddedResource Include="../../DorotiTestbedApp/assets/fonts/LICENSE.roboto.txt" LogicalName="AssetFonts.LICENSE.roboto.txt" Condition="'$(DorotiSampleWebFontSource)' == 'Assets'" />
    <EmccExportedFunction Include="_wgpuDeviceRelease;_wgpuQueueRelease;_wgpuInstanceRelease" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
    <DorotiTargetDescriptor Include="Web" HostKind="BlazorWebAssembly" NativeEntryKind="Managed-Main" RuntimeIdentifier="browser-wasm" TargetFramework="net10.0" TargetPackage="Doroti.Target.Web.browser-wasm" />
    <ProjectReference Include="../../../packages/platforms/web/Doroti.Target.Web.browser-wasm/Doroti.Target.Web.browser-wasm.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.11" PrivateAssets="all" />
    <PackageReference Include="Microsoft.TypeScript.MSBuild" Version="7.0.0" PrivateAssets="all" />
  </ItemGroup>
  <PropertyGroup Condition="'$(DorotiSampleWebFontSource)' == 'Assets'">
    <DorotiWebFontOptions>global::DorotiSampleApp2.Web.WebFonts.Options</DorotiWebFontOptions>
  </PropertyGroup>
  <PropertyGroup Condition="'$(DorotiSampleWebFontSource)' == 'Assets'">
    <DorotiBundleWoff2Decoder>true</DorotiBundleWoff2Decoder>
    <DorotiWebWwwrootExclude>wwwroot/index.html</DorotiWebWwwrootExclude>
  </PropertyGroup>
  <PropertyGroup Condition="'$(DorotiBundleWoff2Decoder)' == 'true'">
    <DefineConstants>$(DefineConstants);DOROTI_LOCAL_FONT_DECODER</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(DorotiBundleWoff2Decoder)' == 'true'">
    <Content Include="FontDecoder/*" Link="wwwroot/fonts/decoder/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(DorotiSampleWebFontSource)' == 'Assets'">
    <Content Remove="wwwroot/index.html" />
    <Content Include="Assets.index.html" Link="wwwroot/index.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(DorotiWebFontValidation)' != 'true'">
    <Compile Remove="Validation/**/*.cs" />
  </ItemGroup>
  <PropertyGroup Condition="'$(DorotiWebFontValidation)' == 'true'">
    <DefineConstants>$(DefineConstants);DOROTI_FONT_PROBE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(DorotiWebFontValidation)' == 'true'">
    <Compile Include="Validation/WebFontProbe.cs" />
    <Content Include="../../DorotiTestbedApp/assets/fonts/Roboto-regular.ttf" Link="wwwroot/font-probe/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../DorotiTestbedApp/assets/fonts/MaterialIcons-Regular.otf" Link="wwwroot/font-probe/icons.otf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="../../../Doroti/src/Doroti.Runner.Sdk/Sdk/Sdk.targets" />
</Project>
