<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../packages/platforms/build/Sdk.props" />
  <Import Project="../../../Doroti/src/Doroti.Runner.Sdk/Sdk/Sdk.props" />
  <PropertyGroup>
    <DorotiMacCatalystTargetFramework Condition="'$(DorotiMacCatalystTargetFramework)' == ''">net10.0-maccatalyst</DorotiMacCatalystTargetFramework>
    <TargetFramework>$(DorotiMacCatalystTargetFramework)</TargetFramework>
    <RuntimeIdentifier>maccatalyst-arm64</RuntimeIdentifier>
    <AssemblyName>DorotiCarouselApp.MacCatalyst</AssemblyName>
    <RootNamespace>DorotiCarouselApp.MacCatalyst</RootNamespace>
    <DorotiAppProject>..\DorotiCarouselApp.csproj</DorotiAppProject>
    <DorotiTarget>MacCatalyst</DorotiTarget>
    <DorotiHostKind>Maui</DorotiHostKind>
    <DorotiNativeEntryKind>UIKit-Main</DorotiNativeEntryKind>
    <UseMaui>true</UseMaui>
    <DefineConstants>$(DefineConstants);MACCATALYST;DOROTI_MAUI</DefineConstants>
    <SupportedOSPlatformVersion>$(DorotiMacCatalystMinimumOSVersion)</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(DorotiMacCatalystTargetFramework)' == 'net10.0-maccatalyst'">16.0</SupportedOSPlatformVersion>
    <CodesignEntitlements>Entitlements.plist</CodesignEntitlements>
    <ApplicationTitle>Doroti Custom Carousel</ApplicationTitle>
    <ApplicationId>dev.doroti.carousel</ApplicationId>
    <DorotiCompileExclude>AppKitDelegate.cs;DorotiNativePlatformBridge.MacOS.cs</DorotiCompileExclude>
    <DorotiProviderBootstrapTargets>$(MSBuildProjectDirectory)/../../../packages/platforms/maui/bootstrap/Doroti.Provider.Bootstrap.targets</DorotiProviderBootstrapTargets>
  </PropertyGroup>
  <ItemGroup>
    <PartialAppManifest Include="Info.plist" />
    <DorotiNativeBindingProject Include="binding\DorotiCarouselApp.MacCatalyst.Native.csproj" />
    <DorotiTargetDescriptor Include="MacCatalyst" HostKind="Maui" NativeEntryKind="UIKit-Main" RuntimeIdentifier="maccatalyst-arm64" TargetFramework="$(DorotiMacCatalystTargetFramework)" TargetPackage="Doroti.Target.MacCatalyst.Maui.maccatalyst-arm64" />
    <ProjectReference Include="../../../packages/platforms/maui/Doroti.Target.MacCatalyst.Maui.maccatalyst-arm64/Doroti.Target.MacCatalyst.Maui.maccatalyst-arm64.csproj" />
  </ItemGroup>
  <Import Project="../../../Doroti/src/Doroti.Runner.Sdk/Sdk/Sdk.targets" />
</Project>