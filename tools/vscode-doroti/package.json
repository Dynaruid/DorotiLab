{
  "name": "doroti",
  "displayName": "Doroti",
  "icon": "images/icon.png",
  "description": "Create, edit and run Doroti applications with metadata Hot Reload.",
  "version": "0.2.0",
  "publisher": "doroti-local",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dynaruid/DorotiLab.git",
    "directory": "tools/vscode-doroti"
  },
  "license": "BSD-3-Clause",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/doroti-workspace.json",
    "onLanguage:csharp"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Templates and file editing work in Restricted Mode. Project analysis, helper/CLI execution and Hot Reload require trust."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "doroti.createProject",
        "title": "Doroti: Create Project",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "doroti.selectProject",
        "title": "Doroti: Select Project",
        "enablement": "isWorkspaceTrusted && !doroti.running"
      },
      {
        "command": "doroti.selectTarget",
        "title": "Doroti: Select Target",
        "enablement": "isWorkspaceTrusted && !doroti.running"
      },
      {
        "command": "doroti.run",
        "title": "Doroti: Run",
        "icon": "$(play)",
        "enablement": "isWorkspaceTrusted && !doroti.running"
      },
      {
        "command": "doroti.hotReload",
        "title": "Doroti: Hot Reload",
        "icon": "$(debug-restart)",
        "enablement": "isWorkspaceTrusted && doroti.reloadSupported && !doroti.reloading"
      },
      {
        "command": "doroti.restart",
        "title": "Doroti: Restart (resets state)",
        "enablement": "isWorkspaceTrusted && doroti.running"
      },
      {
        "command": "doroti.stop",
        "title": "Doroti: Stop",
        "icon": "$(debug-stop)",
        "enablement": "doroti.running"
      },
      {
        "command": "doroti.showLogs",
        "title": "Doroti: Show Logs"
      },
      {
        "command": "doroti.newStatelessWidget",
        "title": "Doroti: New Stateless Widget",
        "enablement": "doroti.isWidgetDocument"
      },
      {
        "command": "doroti.newStatefulWidget",
        "title": "Doroti: New Stateful Widget",
        "enablement": "doroti.isWidgetDocument"
      },
      {
        "command": "doroti.insertWidgetSnippet",
        "title": "Doroti: Insert Widget Snippet",
        "enablement": "doroti.isWidgetDocument"
      },
      {
        "command": "doroti.wrapWidget",
        "title": "Doroti: Wrap with Widget…",
        "enablement": "doroti.isWidgetDocument && isWorkspaceTrusted"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "doroti.run",
          "when": "resourceLangId == csharp && !doroti.running",
          "group": "navigation@10"
        },
        {
          "command": "doroti.hotReload",
          "when": "resourceLangId == csharp && doroti.running",
          "group": "navigation@11"
        },
        {
          "command": "doroti.stop",
          "when": "doroti.running",
          "group": "navigation@12"
        }
      ],
      "editor/context": [
        {
          "command": "doroti.wrapWidget",
          "when": "resourceLangId == csharp && doroti.isWidgetDocument && isWorkspaceTrusted",
          "group": "1_modification@10"
        },
        {
          "command": "doroti.insertWidgetSnippet",
          "when": "resourceLangId == csharp && doroti.isWidgetDocument",
          "group": "1_modification@11"
        }
      ]
    },
    "configuration": {
      "title": "Doroti",
      "properties": {
        "doroti.cliPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the repository Doroti/eng/doroti.ps1 (required for generated apps outside the repository).",
          "scope": "machine-overridable"
        },
        "doroti.powerShellPath": {
          "type": "string",
          "default": "pwsh",
          "description": "PowerShell 7 executable.",
          "scope": "machine"
        },
        "doroti.dotnetPath": {
          "type": "string",
          "default": "dotnet",
          "description": ".NET executable for project creation and development sessions.",
          "scope": "machine-overridable"
        },
        "doroti.device": {
          "type": "string",
          "default": "",
          "description": "Device ID declared by the selected provider.",
          "scope": "machine-overridable"
        },
        "doroti.editing.completions": {
          "type": "boolean",
          "default": true,
          "description": "Doroti completion providers.",
          "scope": "resource"
        },
        "doroti.editing.snippets": {
          "type": "boolean",
          "default": true,
          "description": "Import-aware widget templates and prefix suggestions.",
          "scope": "resource"
        },
        "doroti.editing.codeActions": {
          "type": "boolean",
          "default": true,
          "description": "Semantic widget refactorings and import fixes.",
          "scope": "resource"
        },
        "doroti.editing.types": {
          "type": "boolean",
          "default": true,
          "description": "Fallback type suggestions when Microsoft C# is inactive.",
          "scope": "resource"
        },
        "doroti.editing.hints": {
          "type": "boolean",
          "default": true,
          "description": "Doroti composition hints in hover.",
          "scope": "resource"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "test": "npm run compile && node --test dist/test/*.test.js",
    "package": "npm run compile && npm run build-helper && vsce package --no-dependencies",
    "build-helper": "node scripts/build-helper.cjs",
    "test:editing": "npm run compile && node dist/test/runHost.js"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "@types/vscode": "1.100.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "typescript": "7.0.2"
  }
}
