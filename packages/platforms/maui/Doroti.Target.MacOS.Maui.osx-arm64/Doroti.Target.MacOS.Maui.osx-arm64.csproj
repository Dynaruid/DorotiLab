<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(DorotiMacOSTargetFramework)</TargetFramework>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <AssemblyName>Doroti.Target.MacOS.Maui</AssemblyName>
    <RootNamespace>Doroti.Target.MacOS.Maui</RootNamespace>
    <PackageId>Doroti.Target.MacOS.Maui.osx-arm64</PackageId>
    <Description>Doroti native AppKit MTKView Metal/Skia MAUI composition root for Apple Silicon.</Description>
    <IsDorotiProduct>true</IsDorotiProduct>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <EnableDefaultMauiItems>false</EnableDefaultMauiItems>
    <SupportedOSPlatformVersion>14.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Doroti.Host.Maui/Doroti.Host.Maui.csproj" AdditionalProperties="RuntimeIdentifier=osx-arm64" SetTargetFramework="TargetFramework=$(DorotiMacOSTargetFramework)" SkipGetTargetFrameworkProperties="true" />
    <EmbeddedResource Include="doroti-target-manifest.macos27.json" LogicalName="Doroti.Target.Manifest" Condition="'$(TargetFramework)' == 'net10.0-macos27.0'" />
    <None Include="doroti-target-manifest.macos27.json" Pack="true" PackagePath="doroti/doroti-target-manifest.json" Condition="'$(TargetFramework)' == 'net10.0-macos27.0'" />
    <EmbeddedResource Include="$(IntermediateOutputPath)doroti-target-manifest.json" LogicalName="Doroti.Target.Manifest" Condition="'$(TargetFramework)' == 'net10.0-macos'" />
    <None Include="$(IntermediateOutputPath)doroti-target-manifest.json" Pack="true" PackagePath="doroti" Condition="'$(TargetFramework)' == 'net10.0-macos'" />
    <None Include="buildTransitive/Doroti.Target.MacOS.Maui.osx-arm64.targets" Pack="true" PackagePath="buildTransitive/Doroti.Target.MacOS.Maui.osx-arm64.targets" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(IntermediateOutputPath)Doroti.Provider.Bootstrap.targets" Pack="true" PackagePath="bootstrap/" />
  </ItemGroup>
  <PropertyGroup>
    <DorotiProviderMetadataSource>$(MSBuildProjectDirectory)/doroti-target-manifest.json</DorotiProviderMetadataSource>
    <DorotiProviderMetadataFile>doroti-target-manifest.json</DorotiProviderMetadataFile>
  </PropertyGroup>
  <Import Project="../../Doroti.Provider.PackageMetadata.targets" />
  <ItemGroup>
    <None Include="../../build/**/*" Pack="true" PackagePath="provider-build/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="buildTransitive/Doroti.Target.MacOS.Maui.osx-arm64.props" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>
</Project>