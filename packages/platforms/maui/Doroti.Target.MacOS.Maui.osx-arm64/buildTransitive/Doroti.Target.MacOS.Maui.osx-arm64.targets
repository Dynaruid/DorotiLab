<Project>
  <PropertyGroup><DorotiProviderBootstrapTargets>$(MSBuildThisFileDirectory)../bootstrap/Doroti.Provider.Bootstrap.targets</DorotiProviderBootstrapTargets></PropertyGroup>
  <Import Project="$(DorotiProviderBootstrapTargets)" Condition="'$(DorotiProviderSuppliesBootstrap)' != 'true'" />
  <ItemGroup Condition="'$(DorotiTarget)' == 'macOS' and '@(DorotiTargetDescriptor)' == ''">
    <DorotiTargetDescriptor Include="macOS" HostKind="Maui" NativeEntryKind="AppKit-Main" RuntimeIdentifier="osx-arm64" TargetFramework="$(TargetFramework)" TargetPackage="Doroti.Target.MacOS.Maui.osx-arm64" />
  </ItemGroup>
</Project>
