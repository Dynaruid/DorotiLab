<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(DorotiIosTargetFramework)</TargetFramework>
    <RuntimeIdentifier>iossimulator-x64</RuntimeIdentifier>
    <AssemblyName>Doroti.Target.iOS.Maui</AssemblyName>
    <RootNamespace>Doroti.Target.iOS.Maui</RootNamespace>
    <PackageId>Doroti.Target.iOS.Maui.iossimulator-x64</PackageId>
    <Description>Doroti UIKit SKMetalView MAUI composition root for the x64 iOS simulator.</Description>
    <IsDorotiProduct>true</IsDorotiProduct>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <EnableDefaultMauiItems>false</EnableDefaultMauiItems>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Doroti.Host.Maui/Doroti.Host.Maui.csproj" AdditionalProperties="RuntimeIdentifier=iossimulator-x64;DorotiIosTargetFramework=$(TargetFramework);DorotiIosMauiVersion=$(DorotiIosMauiVersion)" SetTargetFramework="TargetFramework=$(TargetFramework)" SkipGetTargetFrameworkProperties="true" />
    <EmbeddedResource Include="$(IntermediateOutputPath)doroti-target-manifest.json" LogicalName="Doroti.Target.Manifest" />
    <None Include="$(IntermediateOutputPath)doroti-target-manifest.json" Pack="true" PackagePath="doroti" />
    <None Include="buildTransitive/Doroti.Target.iOS.Maui.iossimulator-x64.targets" Pack="true" PackagePath="buildTransitive/Doroti.Target.iOS.Maui.iossimulator-x64.targets" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(IntermediateOutputPath)Doroti.Provider.Bootstrap.targets" Pack="true" PackagePath="bootstrap/" />
  </ItemGroup>
  <PropertyGroup>
    <DorotiProviderMetadataSource>$(MSBuildProjectDirectory)/doroti-target-manifest.json</DorotiProviderMetadataSource>
    <DorotiProviderMetadataSourceFramework>net10.0-ios</DorotiProviderMetadataSourceFramework>
    <DorotiProviderMetadataFile>doroti-target-manifest.json</DorotiProviderMetadataFile>
  </PropertyGroup>
  <Import Project="../../Doroti.Provider.PackageMetadata.targets" />
  <ItemGroup>
    <None Include="../../build/**/*" Pack="true" PackagePath="provider-build/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="buildTransitive/Doroti.Target.iOS.Maui.iossimulator-x64.props" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>
</Project>
