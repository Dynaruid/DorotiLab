<Project>
  <PropertyGroup><DorotiProviderBootstrapTargets>$(MSBuildThisFileDirectory)../bootstrap/Doroti.Provider.Bootstrap.targets</DorotiProviderBootstrapTargets></PropertyGroup>
  <Import Project="$(DorotiProviderBootstrapTargets)" Condition="'$(DorotiProviderSuppliesBootstrap)' != 'true'" />
  <ItemGroup Condition="'$(DorotiTarget)' == 'MacCatalyst' and '@(DorotiTargetDescriptor)' == ''">
    <DorotiTargetDescriptor Include="MacCatalyst" HostKind="Maui" NativeEntryKind="UIKit-Main" RuntimeIdentifier="maccatalyst-arm64" TargetFramework="$(TargetFramework)" TargetPackage="Doroti.Target.MacCatalyst.Maui.maccatalyst-arm64" />
  </ItemGroup>
</Project>
