<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework></TargetFramework>
    <!-- NuGet also evaluates this host without ProjectReference RID metadata.
         Both restore evaluations must retain the selected development assets. -->
    <RuntimeIdentifiers Condition="('$(DorotiIosDevelopment)' == 'true' or '$(DorotiMacDevelopment)' == 'true') and '$(DorotiHostRuntimeIdentifier)' != ''">$(DorotiHostRuntimeIdentifier)</RuntimeIdentifiers>
    <DorotiIosTargetFramework Condition="'$(DorotiIosTargetFramework)' == ''">$(_DorotiDefaultIosTargetFramework)</DorotiIosTargetFramework>
    <TargetFrameworks Condition="'$(RuntimeIdentifier)' == '' and '$(DorotiHostMacOnly)' == 'true'">$(DorotiMacCatalystTargetFramework);$(DorotiMacOSTargetFramework)</TargetFrameworks>
    <TargetFrameworks Condition="'$(RuntimeIdentifier)' == '' and '$(DorotiHostMacOnly)' != 'true' and '$(DorotiHostTargetFrameworks)' == ''">net10.0-windows10.0.19041.0;$(DorotiMacCatalystTargetFramework);$(DorotiMacOSTargetFramework);$(DorotiIosTargetFramework);$(DorotiAndroidTargetFramework)</TargetFrameworks>
    <TargetFrameworks Condition="'$(RuntimeIdentifier)' == '' and '$(DorotiHostTargetFrameworks)' != ''">$(DorotiHostTargetFrameworks)</TargetFrameworks>
    <TargetFrameworks Condition="'$(RuntimeIdentifier)' == 'win-x64'">net10.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(RuntimeIdentifier)' == 'maccatalyst-arm64'">$(DorotiMacCatalystTargetFramework)</TargetFrameworks>
    <TargetFrameworks Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">$(DorotiMacOSTargetFramework)</TargetFrameworks>
    <TargetFrameworks Condition="'$(RuntimeIdentifier)' == 'ios-arm64' or '$(RuntimeIdentifier)' == 'iossimulator-arm64' or '$(RuntimeIdentifier)' == 'iossimulator-x64'">$(DorotiIosTargetFramework)</TargetFrameworks>
    <TargetFrameworks Condition="'$(RuntimeIdentifier)' == 'android-arm64'">$(DorotiAndroidTargetFramework)</TargetFrameworks>
    <TargetFrameworks Condition="'$(RuntimeIdentifier)' == 'android-x64'">$(DorotiAndroidTargetFramework)</TargetFrameworks>
    <!-- NativeAot is an iOS device profile, including RID-less restore queries. -->
    <TargetFrameworks Condition="'$(DorotiCompilationMode)' == 'NativeAot'">$(DorotiIosTargetFramework)</TargetFrameworks>
    <AssemblyName>Doroti.Host.Maui</AssemblyName>
    <PackageId>Doroti.Host.Maui</PackageId>
    <Description>Doroti MAUI SKGLView host with externally owned GPU surface lifecycle.</Description>
    <IsDorotiProduct>true</IsDorotiProduct>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <EnableDefaultMauiItems>false</EnableDefaultMauiItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**</DefaultItemExcludes>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">$(DorotiMacCatalystMinimumOSVersion)</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'macos'">14.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../Doroti/src/Doroti.Desktop/Doroti.Desktop.csproj" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'macos' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'" />
    <None Include="buildTransitive/Doroti.Host.Maui.targets" Pack="true" PackagePath="buildTransitive" />
    <None Include="buildTransitive/Doroti.ProcessText.AndroidManifest.xml" Pack="true" PackagePath="buildTransitive" />
    <ProjectReference Include="../../../../Doroti/src/Doroti.Skia.Vulkan/Doroti.Skia.Vulkan.csproj" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'" />
    <ProjectReference Include="../../../../Doroti/src/Doroti.Skia.Rendering/Doroti.Skia.Rendering.csproj" />
    <ProjectReference Include="../../../../Doroti/src/Doroti.Skia.Fonts/Doroti.Skia.Fonts.csproj" />
    <PackageReference Include="Microsoft.Maui.Controls" Condition="'$(DorotiIosMauiVersion)' == '' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'ios'" />
    <PackageReference Include="Microsoft.Web.WebView2" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'" />
    <PackageReference Include="Microsoft.Maui.Controls" VersionOverride="$(DorotiIosMauiVersion)" Condition="'$(DorotiIosMauiVersion)' != '' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'" />
    <PackageReference Include="Xamarin.AndroidX.Window.WindowJava" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'" />
    <PackageReference Include="SkiaSharp.Views.Maui.Controls" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'macos'" />
    <PackageReference Include="Microsoft.Maui.Platforms.MacOS" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'macos'" />
    <PackageReference Include="Microsoft.Maui.Platforms.MacOS.Essentials" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'macos'" />
    <PackageReference Include="SkiaSharp.Views" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'macos'" />
    <!-- Explicit official assets retain native/static-link build targets for
         device, simulator and NativeAOT profiles. Apple execution is separately qualified. -->
    <PackageReference Include="SkiaSharp.NativeAssets.iOS" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'" />
    <PackageReference Include="SkiaSharp.NativeAssets.MacCatalyst" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'macos'" />
    <ProjectReference Include="../../../../Doroti/src/Doroti.Hosting/Doroti.Hosting.csproj" />
    <ProjectReference Include="../../../../Doroti/src/Doroti.Framework.Services/Doroti.Framework.Services.csproj" />
    <ProjectReference Include="../../../../Doroti/src/Doroti.Ui/Doroti.Ui.csproj" />
    <ProjectReference Include="../../../../Doroti/src/Doroti.Skia.RuntimeEffects/Doroti.Skia.RuntimeEffects.csproj" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <PackageReference Include="Xamarin.AndroidX.WebKit" />
    <PackageReference Include="SkiaSharp.NativeAssets.Android" />
  </ItemGroup>
  <!-- Window and WebKit select the newer AndroidX Core and Collection line.
       Keep Lifecycle and the exact-range Ktx siblings on compatible versions with MAUI 10. -->
  <ItemGroup Condition="$(TargetFramework.StartsWith('net10.0-android'))">
    <PackageReference Include="Xamarin.AndroidX.Collection.Ktx" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModel.Ktx" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModelSavedState" />
    <PackageReference Include="Xamarin.AndroidX.SavedState.SavedState.Ktx" />
  </ItemGroup>
  <ItemGroup Condition="'$(DorotiShapedParagraphs)' == 'true'">
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Android" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.iOS" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.MacCatalyst" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'" />
  </ItemGroup>
  <!-- Mirror MSBuild's RID-agnostic reference handling during graph evaluation.
       dotnet watch identifies a project by path + TFM; propagating the native
       RID here creates a second instance of every shared framework dependency. -->
  <ItemGroup Condition="('$(DorotiIosDevelopment)' == 'true' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios') or ('$(DorotiAndroidDevelopment)' == 'true' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android') or '$(DorotiMacDevelopment)' == 'true'">
    <ProjectReference Update="@(ProjectReference)">
      <GlobalPropertiesToRemove>%(ProjectReference.GlobalPropertiesToRemove);RuntimeIdentifier;RuntimeIdentifiers;SelfContained</GlobalPropertiesToRemove>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../shared/Windows/*.cs" Link="Shared\Windows\%(Filename)%(Extension)" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'" />
    <ProjectReference Include="../../../../Doroti/src/Doroti.Graphics.DirectX/Doroti.Graphics.DirectX.csproj" GlobalPropertiesToRemove="WindowsAppSdkUndockedRegFreeWinRTInitialize;WindowsAppSdkAutoInitialize" Condition="$([System.String]::Copy('$(TargetFramework)').Contains('-windows'))" />
  </ItemGroup>
</Project>
