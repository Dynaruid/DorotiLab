<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(DorotiAndroidTargetFramework)</TargetFramework>
    <RuntimeIdentifier>android-x64</RuntimeIdentifier>
    <AssemblyName>Doroti.Target.Android.Maui</AssemblyName>
    <RootNamespace>Doroti.Target.Android.Maui</RootNamespace>
    <PackageId>Doroti.Target.Android.Maui.android-x64</PackageId>
    <Description>Doroti Android MAUI SurfaceView Graphite Vulkan composition root for x64 emulators.</Description>
    <PackageReleaseNotes>Adds the Android x64 MAUI target with strict GPU surface ownership.</PackageReleaseNotes>
    <IsDorotiProduct>true</IsDorotiProduct>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <EnableDefaultMauiItems>false</EnableDefaultMauiItems>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Doroti.Host.Maui/Doroti.Host.Maui.csproj" AdditionalProperties="RuntimeIdentifier=android-x64" SetTargetFramework="TargetFramework=$(DorotiAndroidTargetFramework)" SkipGetTargetFrameworkProperties="true" />
    <EmbeddedResource Include="$(IntermediateOutputPath)doroti-target-manifest.json" LogicalName="Doroti.Target.Manifest" />
    <None Include="$(IntermediateOutputPath)doroti-target-manifest.json" Pack="true" PackagePath="doroti" />
    <None Include="buildTransitive/Doroti.Target.Android.Maui.android-x64.targets" Pack="true" PackagePath="buildTransitive/Doroti.Target.Android.Maui.android-x64.targets" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(IntermediateOutputPath)Doroti.Provider.Bootstrap.targets" Pack="true" PackagePath="bootstrap/" />
  </ItemGroup>
  <PropertyGroup>
    <DorotiProviderMetadataSource>$(MSBuildProjectDirectory)/doroti-target-manifest.json</DorotiProviderMetadataSource>
    <DorotiProviderMetadataFile>doroti-target-manifest.json</DorotiProviderMetadataFile>
  </PropertyGroup>
  <Import Project="../../Doroti.Provider.PackageMetadata.targets" />
  <ItemGroup>
    <None Include="../../build/**/*" Pack="true" PackagePath="provider-build/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="buildTransitive/Doroti.Target.Android.Maui.android-x64.props" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>
</Project>