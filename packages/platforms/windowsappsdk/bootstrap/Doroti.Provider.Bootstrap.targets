<Project>
  <PropertyGroup>
    <DorotiProviderBuildDirectory Condition="'$(DorotiProviderBuildDirectory)' == '' and Exists('$(MSBuildThisFileDirectory)../provider-build/Sdk.targets')">$(MSBuildThisFileDirectory)../provider-build/</DorotiProviderBuildDirectory>
    <DorotiProviderBuildDirectory Condition="'$(DorotiProviderBuildDirectory)' == ''">$(MSBuildThisFileDirectory)../../build/</DorotiProviderBuildDirectory>
    <DorotiProviderSdkProps>$(DorotiProviderBuildDirectory)Sdk.props</DorotiProviderSdkProps>
    <DorotiProviderSupportsDesktop>true</DorotiProviderSupportsDesktop>
    <DorotiProviderExcludePublishSymbols>true</DorotiProviderExcludePublishSymbols>
    <DorotiProviderReferenceProperties Condition="'$(DorotiIosDevelopment)' == 'true' or '$(DorotiMacDevelopment)' == 'true'">CustomAfterMicrosoftCommonTargets=$(DorotiProviderBuildDirectory)Doroti.IosDevelopmentBinding.targets</DorotiProviderReferenceProperties>
  </PropertyGroup>
  <PropertyGroup>
    <DorotiProviderId>windowsappsdk</DorotiProviderId>
    <DorotiProviderVersion Condition="'$(DorotiProviderVersion)' == ''">0.4.1-beta</DorotiProviderVersion>
    <DorotiProviderCoreRange>[0.4.0-alpha.1,0.5.0)</DorotiProviderCoreRange>
    <DorotiProviderProtocolVersion>1</DorotiProviderProtocolVersion>
    <DorotiProviderToolPackage>Doroti.Tool.WindowsAppSdk</DorotiProviderToolPackage>
    <DorotiProviderProfile Condition="'$(DorotiProviderProfile)' == ''">default:$(RuntimeIdentifier)</DorotiProviderProfile>
    <DorotiProviderSuppliesBootstrap>true</DorotiProviderSuppliesBootstrap>
  </PropertyGroup>
  <ItemGroup>
    <DorotiProviderEntryLine Include="    [global::System.STAThread]" Condition="'$(DorotiNativeEntryKind)' == 'Win32-WinMain'" />
    <DorotiProviderEntryLine Include="    public static int Main(string[] args) =&gt;" Condition="'$(DorotiNativeEntryKind)' == 'Win32-WinMain'" />
    <DorotiProviderEntryLine Include="        global::Doroti.Host.WindowsAppSdk.DorotiWindowsAppSdkRunner.Run(() =&gt; Create(args))%3B" Condition="'$(DorotiNativeEntryKind)' == 'Win32-WinMain'" />
  </ItemGroup>
  <Import Project="$(DorotiProviderBuildDirectory)Sdk.targets" Condition="'$(DorotiRunnerSdkActive)' == 'true'" />
  <Target Name="DorotiEmbedNativeAotSkiaHash" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolvePackageAssets"
          Condition="'$(PublishAot)' == 'true' and '$(DorotiRunnerSdkActive)' == 'true'">
    <ItemGroup>
      <_DorotiSkiaImplementation Include="@(RuntimeCopyLocalItems)" Condition="'%(RuntimeCopyLocalItems.Filename)%(RuntimeCopyLocalItems.Extension)' == 'SkiaSharp.dll'" />
    </ItemGroup>
    <Error Condition="'@(_DorotiSkiaImplementation->Count())' != '1'" Text="Windows Native AOT requires exactly one resolved SkiaSharp runtime assembly." />
    <GetFileHash Files="@(_DorotiSkiaImplementation)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_DorotiSkiaImplementationSha256" />
    </GetFileHash>
    <WriteLinesToFile File="$(IntermediateOutputPath)doroti-skia-implementation.sha256" Lines="$(_DorotiSkiaImplementationSha256)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)doroti-skia-implementation.sha256" LogicalName="Doroti.Skia.NativeAot.SkiaSharp.sha256" />
      <FileWrites Include="$(IntermediateOutputPath)doroti-skia-implementation.sha256" />
    </ItemGroup>
  </Target>
</Project>
