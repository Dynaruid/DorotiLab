<Project>
  <PropertyGroup>
    <!-- Source runners do not import the provider's NuGet build props. -->
    <DorotiMono11PthreadsLibrary Condition="'$(DorotiMono11PthreadsLibrary)' == '' and Exists('$(MSBuildThisFileDirectory)../web/Doroti.Target.Web.browser-wasm/build/DorotiMono11Pthreads.js')">$(MSBuildThisFileDirectory)../web/Doroti.Target.Web.browser-wasm/build/DorotiMono11Pthreads.js</DorotiMono11PthreadsLibrary>
    <_DorotiWebCilBuildHook>_ResolveWasmOutputs</_DorotiWebCilBuildHook>
    <_DorotiWebCilBuildHook Condition="'$(TargetFramework)' == 'net11.0'">_ConvertBuildDllsToWebcil</_DorotiWebCilBuildHook>
  </PropertyGroup>
  <!-- Emscripten 3.1.56 implicitly uses STACK_FIRST at -O0 unless GLOBAL_BASE
       is explicit. That puts the main pthread stack's lower bound at zero,
       which Mono rejects in mono_threads_platform_get_stack_bounds. Explicitly
       retain Emscripten's normal global base without changing Debug optimization,
       symbols, assertions, or threading. Append user flags last so their explicit
       GLOBAL_BASE can still take precedence. -->
  <Target Name="DorotiConfigureWebDebugStackLayout"
          BeforeTargets="_PrepareForBrowserWasmBuildNative"
          Condition="'$(DorotiTarget)' == 'Web' and '$(Configuration)' == 'Debug' and '$(WasmEnableThreads)' == 'true' and '$(EmscriptenVersion)' == '3.1.56'">
    <PropertyGroup>
      <EmccExtraLDFlags>-sGLOBAL_BASE=1024 $(EmccExtraLDFlags)</EmccExtraLDFlags>
    </PropertyGroup>
  </Target>

  <Target Name="DorotiConfigureMono11PthreadRetirement"
          BeforeTargets="_BrowserWasmWriteRspForLinking"
          Condition="'$(DorotiTarget)' == 'Web' and '$(TargetFramework)' == 'net11.0' and '$(RuntimeFrameworkVersion)' == '11.0.0' and '$(WasmEnableThreads)' == 'true'">
    <Error Code="DOROTIWEB056" Condition="'$(EmscriptenVersion)' != '6.0.3' or !Exists('$(DorotiMono11PthreadsLibrary)')"
           Text="Mono 11.0.0 threaded retirement requires the qualified Emscripten 6.0.3 link-time adapter." />
    <PropertyGroup>
      <EmccExtraLDFlags>$(EmccExtraLDFlags) --js-library="$(DorotiMono11PthreadsLibrary)"</EmccExtraLDFlags>
    </PropertyGroup>
  </Target>
  <Target Name="DorotiTrackMono11PthreadRetirement" BeforeTargets="_BrowserWasmLinkDotNet"
          Condition="'$(DorotiTarget)' == 'Web' and '$(TargetFramework)' == 'net11.0' and '$(RuntimeFrameworkVersion)' == '11.0.0' and '$(WasmEnableThreads)' == 'true'">
    <ItemGroup><_WasmLinkDependencies Include="$(DorotiMono11PthreadsLibrary)" /></ItemGroup>
  </Target>

  <!-- Opt-in for deep widget trees on Safari's limited Worker stack. Interpret
       the Dart async layer too: sustained Safari runs stop responding with a
       ThreadPool continuation stuck inside AOT ObserveTaskAsync. Keep Skia
       renderer/interop AOT compiled. Recursive mount/layout and async frames use
       the interpreter's managed execution stack and suspension checkpoints.
       This metadata is the .NET 10 WASM SDK's assembly interpretation contract. -->
  <Target Name="DorotiConfigureWebWidgetTreeAot"
          BeforeTargets="_WasmAotCompileApp"
          Condition="'$(DorotiTarget)' == 'Web' and '$(RunAOTCompilation)' == 'true' and '$(DorotiWebInterpretWidgetTree)' == 'true'">
    <ItemGroup>
      <_WasmAssembliesInternal AOT_InternalForceToInterpret="true"
          Condition="'%(_WasmAssembliesInternal.Filename)' == 'Doroti.Framework.Widgets' or '%(_WasmAssembliesInternal.Filename)' == 'Doroti.Framework.Rendering' or '%(_WasmAssembliesInternal.Filename)' == 'Doroti.Runtime'" />
    </ItemGroup>
  </Target>

  <!-- WebCIL conversion reuses outputs by timestamp. AOT publishing can strip
       method bodies, while the next interpreted build needs the full IL again.
       Track the execution mode and all assemblies (including project references
       and this runner), as well as package paths/content, before reusing outputs.
       ILLink's timestamp semaphore does not track changed feature values or a
       removed threads root descriptor. The SDK also reuses runtime icall tables
       solely by existence; both caches must follow the execution identity. -->
  <Target Name="DorotiInvalidateWebDependencyWebCil"
          BeforeTargets="PrepareForILLink;_GenerateManagedToNative;$(_DorotiWebCilBuildHook);ProcessPublishFilesForWasm"
          DependsOnTargets="ResolveReferences;_ResolveWasmConfiguration"
          Condition="'$(DorotiTarget)' == 'Web' and '$(WasmEnableWebcil)' != 'false'">
    <ItemGroup>
      <_DorotiWebDependencyAssembly Include="@(ReferenceCopyLocalPaths)"
          Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll'" />
      <_DorotiWebDependencyAssembly Include="$(TargetPath)" Condition="Exists('$(TargetPath)')" />
    </ItemGroup>
    <GetFileHash Files="@(_DorotiWebDependencyAssembly)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_DorotiWebDependencyHashedAssembly" />
    </GetFileHash>
    <PropertyGroup>
      <_DorotiWebDependencyIdentityFile>$(IntermediateOutputPath)doroti-webcil-dependencies.identity</_DorotiWebDependencyIdentityFile>
    </PropertyGroup>
    <ItemGroup>
      <_DorotiWebDependencyIdentity Include="mode|$(NETCoreSdkVersion)|$(TargetFramework)|$(RuntimeFrameworkVersion)|$(UseMonoRuntime)|$(WasmSdkPackVersion)|$(EmscriptenVersion)|$(Configuration)|$(RunAOTCompilation)|$(WasmStripILAfterAOT)|$(WasmEnableThreads)|$(DorotiWebInterpretWidgetTree)" />
      <_DorotiWebDependencyIdentity Include="cache-policy|linked-and-runtime-bindings-v1" />
      <!-- A policy change also needs unstripped IL, even if assembly bytes and
           the public opt-in flag are identical to an earlier AOT publish. -->
      <_DorotiWebDependencyIdentity Include="widget-tree-policy|Widgets,Rendering,Runtime"
          Condition="'$(DorotiWebInterpretWidgetTree)' == 'true'" />
      <_DorotiWebDependencyIdentity Include="@(_DorotiWebDependencyHashedAssembly->'%(FullPath)|%(FileHash)')" />
    </ItemGroup>
    <ReadLinesFromFile File="$(_DorotiWebDependencyIdentityFile)" Condition="Exists('$(_DorotiWebDependencyIdentityFile)')">
      <Output TaskParameter="Lines" ItemName="_DorotiPreviousWebDependencyIdentity" />
    </ReadLinesFromFile>
    <ItemGroup Condition="'@(_DorotiWebDependencyIdentity)' != '@(_DorotiPreviousWebDependencyIdentity)'">
      <_DorotiStaleWebDependencyWebCil Include="@(_DorotiWebDependencyAssembly->'$(IntermediateOutputPath)webcil/%(Filename).wasm')" />
      <_DorotiStaleWebDependencyWebCil Include="@(_DorotiWebDependencyAssembly->'$(IntermediateOutputPath)webcil/publish/%(Filename).wasm')" />
      <_DorotiStaleWebNativeBinding Include="$(IntermediateOutputPath)wasm/for-build/runtime-icall-table.h;$(IntermediateOutputPath)wasm/for-build/m2n_cache.txt;$(IntermediateOutputPath)wasm/for-publish/runtime-icall-table.h;$(IntermediateOutputPath)wasm/for-publish/m2n_cache.txt" />
    </ItemGroup>
    <Delete Files="$(_LinkSemaphore)"
            Condition="'$(PublishTrimmed)' == 'true' and '$(_LinkSemaphore)' != '' and '@(_DorotiStaleWebDependencyWebCil)' != ''" />
    <Delete Files="@(_DorotiStaleWebDependencyWebCil)" />
    <Delete Files="@(_DorotiStaleWebNativeBinding)" />
    <Message Importance="High" Text="Doroti Web: assembly or execution mode changed; regenerating cached linked/WebCIL assemblies and native binding tables."
             Condition="'@(_DorotiStaleWebDependencyWebCil)' != ''" />
    <WriteLinesToFile File="$(_DorotiWebDependencyIdentityFile)" Lines="@(_DorotiWebDependencyIdentity)"
                      Overwrite="true" WriteOnlyWhenDifferent="true" Condition="'@(_DorotiWebDependencyIdentity)' != ''" />
    <ItemGroup>
      <FileWrites Include="$(_DorotiWebDependencyIdentityFile)" />
    </ItemGroup>
  </Target>
</Project>
