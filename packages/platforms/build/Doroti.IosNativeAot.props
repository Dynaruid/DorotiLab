<Project>
  <PropertyGroup>
    <DorotiIosNativeAotProfileImported>true</DorotiIosNativeAotProfileImported>
    <DorotiIosNativeAotProfilePath>$(MSBuildThisFileFullPath)</DorotiIosNativeAotProfilePath>
  </PropertyGroup>
  <!-- Use the installed iOS workload for .NET 10, while retaining the
       explicit Xcode 27.0 profile and the separate .NET 11 RC2 profile. -->
  <PropertyGroup Condition="'$(DorotiIosTargetFramework)' == 'net10.0-ios' or '$(DorotiIosTargetFramework)' == 'net10.0-ios27.0'">
    <DorotiCompilationMode Condition="'$(DorotiCompilationMode)' == ''">Mono</DorotiCompilationMode>
    <DorotiHostTargetFrameworks Condition="'$(DorotiHostTargetFrameworks)' == ''">$(DorotiIosTargetFramework)</DorotiHostTargetFrameworks>
    <NoWarn Condition="'$(DorotiIosTargetFramework)' == 'net10.0-ios27.0'">$(NoWarn);XCODE_27_0_PREVIEW</NoWarn>
    <!-- Choose the Debug interpreter split in Sdk.targets, after the runner's
         app project, assembly name and RID are known. Explicit caller settings
         and NativeAOT remain separate profiles. -->
    <_DorotiIosDebugInterpreterDefault Condition="'$(Configuration)' == 'Debug' and '$(DorotiCompilationMode)' != 'NativeAot' and '$(UseInterpreter)' != 'false' and '$(MtouchInterpreter)' == ''">true</_DorotiIosDebugInterpreterDefault>
  </PropertyGroup>
  <PropertyGroup Condition="'$(DorotiCompilationMode)' == '' and '$(PublishAot)' != 'false' and '$(Configuration)' == 'Release' and ('$(RuntimeIdentifier)' == 'ios-arm64' or '$(MSBuildProjectName)' == 'Doroti.Target.iOS.Maui.ios-arm64')">
    <DorotiCompilationMode>NativeAot</DorotiCompilationMode>
  </PropertyGroup>
  <PropertyGroup Condition="'$(DorotiIosDevelopment)' == 'true' and '$(DorotiIosTargetFramework)' == 'net11.0-ios'">
    <DorotiIosMauiVersion Condition="'$(DorotiIosMauiVersion)' == ''">11.0.0-rc.2.26505.5</DorotiIosMauiVersion>
    <DorotiHostTargetFrameworks>$(DorotiIosTargetFramework)</DorotiHostTargetFrameworks>
    <Registrar>partial-static</Registrar>
  </PropertyGroup>
  <!-- Selected before target-framework discovery, including RID-less restore.
       PublishAot belongs on the executable and is deliberately not set here. -->
  <PropertyGroup Condition="'$(DorotiCompilationMode)' == 'NativeAot'">
    <ArtifactsPath Condition="'$(ArtifactsPath)' == ''">$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '.doroti', 'compilation', 'NativeAot', '$(RuntimeIdentifier)'))</ArtifactsPath>
    <DorotiIosTargetFramework Condition="'$(DorotiIosTargetFramework)' == ''">net11.0-ios</DorotiIosTargetFramework>
    <DorotiIosMauiVersion Condition="'$(DorotiIosMauiVersion)' == ''">11.0.0-rc.2.26505.5</DorotiIosMauiVersion>
  </PropertyGroup>
</Project>
