<Project>
  <PropertyGroup>
    <DorotiIosNativeAotProfileImported>true</DorotiIosNativeAotProfileImported>
    <DorotiIosNativeAotProfilePath>$(MSBuildThisFileFullPath)</DorotiIosNativeAotProfilePath>
    <_DorotiDefaultIosTargetFramework>net10.0-ios</_DorotiDefaultIosTargetFramework>
    <_DorotiDefaultIosTargetFramework Condition="'$(NETCoreSdkVersion)' != '' and $([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '11.0'))">net11.0-ios</_DorotiDefaultIosTargetFramework>
    <DorotiIosTargetFramework Condition="'$(DorotiIosTargetFramework)' == '' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">$(TargetFramework)</DorotiIosTargetFramework>
    <DorotiIosTargetFramework Condition="'$(DorotiIosTargetFramework)' == '' and ('$(DorotiIosProject)' == 'true' or $(MSBuildProjectName.StartsWith('Doroti.Target.iOS.')) or $(RuntimeIdentifier.StartsWith('ios-')) or $(RuntimeIdentifier.StartsWith('iossimulator-')))">$(_DorotiDefaultIosTargetFramework)</DorotiIosTargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="'$(DorotiIosTargetFramework)' != ''">
    <DorotiCompilationMode Condition="'$(DorotiCompilationMode)' == '' and ('$(PublishAot)' == 'true' or ('$(DorotiIosNativeAotByDefault)' == 'true' and '$(PublishAot)' != 'false' and '$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' == 'ios-arm64'))">NativeAot</DorotiCompilationMode>
    <DorotiCompilationMode Condition="'$(DorotiCompilationMode)' == '' and $(DorotiIosTargetFramework.StartsWith('net11.'))">CoreClr</DorotiCompilationMode>
    <DorotiCompilationMode Condition="'$(DorotiCompilationMode)' == ''">Mono</DorotiCompilationMode>
    <DorotiIosMauiVersion Condition="'$(DorotiIosMauiVersion)' == '' and $(DorotiIosTargetFramework.StartsWith('net11.'))">11.0.10</DorotiIosMauiVersion>
    <DorotiHostTargetFrameworks Condition="'$(DorotiHostTargetFrameworks)' == ''">$(DorotiIosTargetFramework)</DorotiHostTargetFrameworks>
    <NoWarn Condition="'$(DorotiIosTargetFramework)' == 'net10.0-ios27.0'">$(NoWarn);XCODE_27_0_PREVIEW</NoWarn>
    <_DorotiIosDebugInterpreterDefault Condition="'$(Configuration)' == 'Debug' and '$(DorotiCompilationMode)' == 'Mono' and '$(UseInterpreter)' != 'false' and '$(MtouchInterpreter)' == ''">true</_DorotiIosDebugInterpreterDefault>
    <Registrar Condition="'$(Registrar)' == '' and '$(DorotiIosDevelopment)' == 'true' and '$(DorotiCompilationMode)' == 'CoreClr'">partial-static</Registrar>
  </PropertyGroup>
  <!-- Selected before target-framework discovery, including RID-less restore.
       PublishAot belongs on the executable and is deliberately not set here. -->
  <PropertyGroup Condition="'$(DorotiCompilationMode)' == 'NativeAot' and '$(DorotiIosTargetFramework)' != ''">
    <ArtifactsPath Condition="'$(ArtifactsPath)' == ''">$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '.doroti', 'compilation', 'NativeAot', '$(RuntimeIdentifier)'))</ArtifactsPath>
  </PropertyGroup>
</Project>
