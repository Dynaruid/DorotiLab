<Project>
  <PropertyGroup Condition="'$(DorotiHostKind)' == 'Qt'">
    <DorotiQtVersion Condition="'$(DorotiQtVersion)' == ''">6.12.0</DorotiQtVersion>
    <DorotiQtWebEngineVersion Condition="'$(DorotiQtWebEngineVersion)' == ''">6.140.0</DorotiQtWebEngineVersion>
    <DorotiQtWebEngineDeployment Condition="'$(DorotiQtWebEngineDeployment)' == ''">bundled</DorotiQtWebEngineDeployment>
    <DorotiPackageFormat Condition="'$(DorotiPackageFormat)' == ''">directory</DorotiPackageFormat>
    <DorotiQtRuntimeTool>$(MSBuildThisFileDirectory)qt_runtime.py</DorotiQtRuntimeTool>
    <DorotiBuildQtNative Condition="'$(DorotiBuildQtNative)' == ''">false</DorotiBuildQtNative>
    <DorotiGStreamerTextures Condition="'$(DorotiGStreamerTextures)' == ''">false</DorotiGStreamerTextures>
    <_DorotiGStreamerTexturesFlag Condition="'$(DorotiGStreamerTextures)' == 'true'">ON</_DorotiGStreamerTexturesFlag>
    <_DorotiGStreamerTexturesFlag Condition="'$(DorotiGStreamerTextures)' != 'true'">OFF</_DorotiGStreamerTexturesFlag>
    <DorotiQtQuick Condition="'$(DorotiQtQuick)' == ''">true</DorotiQtQuick>
    <DorotiQtGraphite Condition="'$(DorotiQtGraphite)' == ''">true</DorotiQtGraphite>
    <DorotiQtWebEngine Condition="'$(DorotiQtWebEngine)' == ''">false</DorotiQtWebEngine>
    <_DorotiQtWebEngineFlag Condition="'$(DorotiQtWebEngine)' == 'true'">ON</_DorotiQtWebEngineFlag>
    <_DorotiQtWebEngineFlag Condition="'$(DorotiQtWebEngine)' != 'true'">OFF</_DorotiQtWebEngineFlag>
    <_DorotiQtQuickFlag Condition="'$(DorotiQtQuick)' == 'true'">ON</_DorotiQtQuickFlag>
    <_DorotiQtQuickFlag Condition="'$(DorotiQtQuick)' != 'true'">OFF</_DorotiQtQuickFlag>
    <_DorotiQtGraphiteFlag Condition="'$(DorotiQtGraphite)' == 'true'">ON</_DorotiQtGraphiteFlag>
    <_DorotiQtGraphiteFlag Condition="'$(DorotiQtGraphite)' != 'true'">OFF</_DorotiQtGraphiteFlag>
    <!-- A prebuilt shim from another backend must never become this profile's
         default. Explicit prebuilt directories are still supported. -->
    <DorotiQtNativeBuildDirectory Condition="'$(DorotiQtNativeBuildDirectory)' == ''">$(BaseIntermediateOutputPath)$(Configuration)/qt-native/qt-$(DorotiQtVersion)-web-$(DorotiQtWebEngineVersion)-quick-$(_DorotiQtQuickFlag)-graphite-$(_DorotiQtGraphiteFlag)-webengine-$(_DorotiQtWebEngineFlag)-gstreamer-$(_DorotiGStreamerTexturesFlag)</DorotiQtNativeBuildDirectory>
  </PropertyGroup>
  <ItemGroup Condition="'$(DorotiHostKind)' == 'Qt'">
    <_DorotiQtRequiredLicense Include="README.md;LGPL-3.txt;GPL-3.txt;Wayland-background-effect-MIT.txt" />
    <_DorotiQtRequiredLicense Include="LGPL-2.1.txt" Condition="'$(DorotiGStreamerTextures)' == 'true'" />
    <DorotiLicense Include="$(DorotiQtNativeSourceDirectory)/licenses/LGPL-2.1.txt"
                   TargetPath="licenses/doroti-linux/LGPL-2.1.txt" Condition="'$(DorotiGStreamerTextures)' == 'true'" />
  </ItemGroup>
  <Target Name="ValidateDorotiQtLicenseNotices" BeforeTargets="PrepareForBuild;ComputeFilesToPublish"
          Condition="'$(DorotiHostKind)' == 'Qt'">
    <Error Code="DOROTIQTLICENSE001" Condition="!Exists('$(DorotiQtNativeSourceDirectory)/licenses/%(_DorotiQtRequiredLicense.Identity)')"
           Text="Qt distribution notice is missing: $(DorotiQtNativeSourceDirectory)/licenses/%(_DorotiQtRequiredLicense.Identity)." />
  </Target>
  <PropertyGroup Condition="'$(DorotiQtDevelopment)' == 'true' and '$(DorotiHostKind)' == 'Qt'">
    <Optimize>false</Optimize>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <StartupHookSupport Condition="'$(StartupHookSupport)' == ''">true</StartupHookSupport>
  </PropertyGroup>
  <Target Name="ValidateDorotiQtDevelopment" BeforeTargets="PrepareForBuild;PrepareForPublish"
          Condition="'$(DorotiQtDevelopment)' == 'true'">
    <Error Code="DOROTIQT007"
           Condition="!$([MSBuild]::IsOSPlatform('Linux')) or '$(DorotiTarget)' != 'Linux' or '$(DorotiHostKind)' != 'Qt' or '$(Configuration)' != 'Debug' or '$(RuntimeIdentifier)' != 'linux-x64' or '$(PublishAot)' == 'true' or '$(PublishTrimmed)' == 'true' or '$(PublishSingleFile)' == 'true' or '$(Optimize)' == 'true' or '$(DebugType)' != 'portable' or '$(StartupHookSupport)' == 'false'"
           Text="Linux Qt Hot Reload requires Linux/linux-x64, an unoptimized Debug Qt runner with portable symbols and startup hooks, and untrimmed directory output. Release, NativeAOT, trimming and single-file output are unsupported for development sessions." />
  </Target>
  <Target Name="ValidateDorotiQtConfiguration" BeforeTargets="PrepareForBuild;PrepareForPublish"
          Condition="'$(DorotiHostKind)' == 'Qt'">
    <Error Code="DOROTIQT008" Condition="'$(DorotiQtWebEngineDeployment)' != 'bundled' and '$(DorotiQtWebEngineDeployment)' != 'download'"
           Text="DorotiQtWebEngineDeployment requires bundled or download." />
    <Error Code="DOROTIQT009" Condition="'$(DorotiQtWebEngineDeployment)' == 'download' and ('$(DorotiQtWebEngine)' != 'true' or '$(DorotiPackageFormat)' != 'deb')"
           Text="WebEngine download requires DorotiQtWebEngine=true and packageformat=deb. Use bundled for directory/portable deployment." />
    <Error Code="DOROTIQT002"
           Condition="('$(DorotiQtQuick)' != 'true' and '$(DorotiQtQuick)' != 'false') or ('$(DorotiQtGraphite)' != 'true' and '$(DorotiQtGraphite)' != 'false') or ('$(DorotiQtWebEngine)' != 'true' and '$(DorotiQtWebEngine)' != 'false') or ('$(DorotiGStreamerTextures)' != 'true' and '$(DorotiGStreamerTextures)' != 'false') or ('$(DorotiBuildQtNative)' != '' and '$(DorotiBuildQtNative)' != 'true' and '$(DorotiBuildQtNative)' != 'false')"
           Text="Doroti Qt switches require true or false: DorotiQtQuick, DorotiQtGraphite, DorotiQtWebEngine, DorotiGStreamerTextures and DorotiBuildQtNative." />
    <Error Code="DOROTIQT003" Condition="'$(DorotiQtQuick)' == 'true' and '$(DorotiQtGraphite)' != 'true'"
           Text="Qt Quick requires Graphite Vulkan. For the serial OpenGL comparison set DorotiQtQuick=false, DorotiQtGraphite=false and DorotiQtWebEngine=false; launch with DOROTI_LINUX_GRAPHITE=0." />
    <Error Code="DOROTIQT004" Condition="'$(DorotiQtWebEngine)' == 'true' and '$(DorotiQtQuick)' != 'true'"
           Text="Qt WebEngine requires DorotiQtQuick=true. Disable DorotiQtWebEngine when selecting the Widgets backend." />
    <Error Code="DOROTIQT005" Condition="'$(DorotiLinuxDesktop)' == 'true' and '$(DorotiQtQuick)' != 'true'"
           Text="The Linux Desktop adapter requires DorotiQtQuick=true." />
  </Target>
  <Target Name="ValidateDorotiQtPublishMode" BeforeTargets="PrepareForBuild;PrepareForPublish"
          Condition="'$(DorotiHostKind)' == 'Qt'">
    <Error Code="DOROTIQT001" Condition="'$(PublishTrimmed)' == 'true'"
           Text="Qt official Graphite requires the original SkiaSharp managed assembly for package provenance. PublishTrimmed is not supported; use an untrimmed publish." />
  </Target>
  <!-- CMake owns dependency/toolchain discovery and its incremental native graph.
       Keep configuration outputs separate and do not replace it with an mtime stamp. -->
  <Target Name="BuildDorotiQtNative" BeforeTargets="Build"
          DependsOnTargets="ValidateDorotiQtConfiguration"
          Condition="'$(DorotiHostKind)' == 'Qt' and '$(DorotiBuildQtNative)' == 'true'">
    <MakeDir Directories="$(DorotiQtNativeBuildDirectory)" />
    <Exec Command="cmake -S &quot;$(DorotiQtNativeSourceDirectory)&quot; -B &quot;$(DorotiQtNativeBuildDirectory)&quot; -DCMAKE_BUILD_TYPE=$(Configuration) -DDOROTI_QT_GRAPHITE=$(_DorotiQtGraphiteFlag) -DDOROTI_QT_QUICK=$(_DorotiQtQuickFlag) -DDOROTI_QT_WEBENGINE=$(_DorotiQtWebEngineFlag) -DDOROTI_GSTREAMER_TEXTURES=$(_DorotiGStreamerTexturesFlag) -DDOROTI_QT_VERSION=&quot;$(DorotiQtVersion)&quot; -DDOROTI_QT_SDK=&quot;$(DorotiQtSdkDirectory)&quot; -DDOROTI_QT_WEBENGINE_SDK=&quot;$(DorotiQtWebEngineSdkDirectory)&quot; -DDOROTI_QT_WEBENGINE_VERSION=&quot;$(DorotiQtWebEngineVersion)&quot; -DDOROTI_APP_ICON=&quot;$(DorotiLinuxIcon)&quot;" Timeout="1200000" />
    <PropertyGroup>
      <_DorotiQtCleanFirst Condition="'$(DorotiRebuildDependencies)' == 'true'">--clean-first</_DorotiQtCleanFirst>
    </PropertyGroup>
    <Exec Command="cmake --build &quot;$(DorotiQtNativeBuildDirectory)&quot; --config $(Configuration) $(_DorotiQtCleanFirst)" Timeout="1200000" />
  </Target>
  <Target Name="CopyDorotiQtNative" AfterTargets="Build;Publish"
          DependsOnTargets="ValidateDorotiQtConfiguration"
          Condition="'$(DorotiHostKind)' == 'Qt'">
    <Error Code="DOROTIQT006" Condition="!Exists('$(DorotiQtNativeBuildDirectory)/libdoroti_qt_host.so')"
           Text="The selected Qt native shim is missing from $(DorotiQtNativeBuildDirectory). Build it on Linux, or set DorotiQtNativeBuildDirectory to a prebuilt directory matching these Qt options when DorotiBuildQtNative=false or publishing with --no-build." />
    <!-- Equal length/mtime does not imply equal native code (restored artifacts
         can preserve both). Always copy the library selected by this build. -->
    <Copy SourceFiles="$(DorotiQtNativeBuildDirectory)/libdoroti_qt_host.so" DestinationFolder="$(TargetDir)" />
    <Copy SourceFiles="$(DorotiQtNativeBuildDirectory)/doroti-qt-build.json" DestinationFolder="$(TargetDir)" Condition="Exists('$(DorotiQtNativeBuildDirectory)/doroti-qt-build.json')" />
    <Copy SourceFiles="$(DorotiQtNativeBuildDirectory)/doroti-qt-build.json" DestinationFolder="$(PublishDir)" Condition="'$(PublishDir)' != '' and Exists('$(DorotiQtNativeBuildDirectory)/doroti-qt-build.json')" />
    <Copy SourceFiles="$(DorotiQtNativeBuildDirectory)/libdoroti_texture_gstreamer.so" DestinationFolder="$(TargetDir)" Condition="'$(DorotiGStreamerTextures)' == 'true'" />
    <Copy SourceFiles="$(DorotiQtNativeBuildDirectory)/libdoroti_texture_gstreamer.so" DestinationFolder="$(PublishDir)" Condition="'$(DorotiGStreamerTextures)' == 'true' and '$(PublishDir)' != '' and '$(PublishSingleFile)' != 'true'" />
    <Delete Files="$(TargetDir)libdoroti_texture_gstreamer.so" Condition="'$(DorotiGStreamerTextures)' != 'true'" />
    <Delete Files="$(PublishDir)libdoroti_texture_gstreamer.so" Condition="'$(DorotiGStreamerTextures)' != 'true' and '$(PublishDir)' != '' and '$(PublishSingleFile)' != 'true'" />
    <Copy SourceFiles="$(DorotiQtNativeBuildDirectory)/libdoroti_webview_qt.so" DestinationFolder="$(TargetDir)" Condition="'$(DorotiQtWebEngine)' == 'true'" />
    <Copy SourceFiles="$(DorotiQtNativeBuildDirectory)/libdoroti_webview_qt.so" DestinationFolder="$(PublishDir)" Condition="'$(DorotiQtWebEngine)' == 'true' and '$(PublishDir)' != '' and '$(PublishSingleFile)' != 'true'" />
    <Copy SourceFiles="$(DorotiQtNativeBuildDirectory)/doroti-webview-runtime.json" DestinationFolder="$(TargetDir)" Condition="'$(DorotiQtWebEngine)' == 'true'" />
    <Copy SourceFiles="$(DorotiQtNativeBuildDirectory)/doroti-webview-runtime.json" DestinationFolder="$(PublishDir)" Condition="'$(DorotiQtWebEngine)' == 'true' and '$(PublishDir)' != '' and '$(PublishSingleFile)' != 'true'" />
    <Delete Files="$(TargetDir)libdoroti_webview_qt.so;$(TargetDir)doroti-webview-runtime.json" Condition="'$(DorotiQtWebEngine)' != 'true'" />
    <Delete Files="$(PublishDir)libdoroti_webview_qt.so;$(PublishDir)doroti-webview-runtime.json" Condition="'$(DorotiQtWebEngine)' != 'true' and '$(PublishDir)' != '' and '$(PublishSingleFile)' != 'true'" />
    <Copy SourceFiles="$(DorotiQtNativeBuildDirectory)/libdoroti_qt_host.so" DestinationFolder="$(PublishDir)" Condition="'$(PublishDir)' != '' and '$(PublishSingleFile)' != 'true'" />
  </Target>
  <!-- After-publish copying cannot put assets into an already generated bundle.
       Register the selected native assets before the SDK collects its inputs,
       including no-build publishes using an explicit prebuilt directory. -->
  <Target Name="IncludeDorotiQtSingleFileAssets" BeforeTargets="_ComputeFilesToBundle"
          DependsOnTargets="ValidateDorotiQtConfiguration"
          Condition="'$(DorotiHostKind)' == 'Qt' and '$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <_DorotiQtBundleNative Include="$(DorotiQtNativeBuildDirectory)/libdoroti_qt_host.so" />
      <_DorotiQtBundleNative Include="$(DorotiQtNativeBuildDirectory)/libdoroti_texture_gstreamer.so" Condition="'$(DorotiGStreamerTextures)' == 'true'" />
      <_DorotiQtBundleNative Include="$(DorotiQtNativeBuildDirectory)/libdoroti_webview_qt.so;$(DorotiQtNativeBuildDirectory)/doroti-webview-runtime.json" Condition="'$(DorotiQtWebEngine)' == 'true'" />
    </ItemGroup>
    <Error Code="DOROTIQT006" Condition="!Exists('%(_DorotiQtBundleNative.Identity)')"
           Text="The selected Qt bundle asset is missing: %(_DorotiQtBundleNative.Identity). Build the matching native profile or set DorotiQtNativeBuildDirectory to a complete prebuilt directory." />
    <ItemGroup>
      <!-- Package runtime assets can already supply these names. Prefer the
           same selected native profile used by the normal build/copy targets. -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
          Condition="'%(ResolvedFileToPublish.RelativePath)' == 'libdoroti_qt_host.so' or '%(ResolvedFileToPublish.RelativePath)' == 'libdoroti_texture_gstreamer.so' or '%(ResolvedFileToPublish.RelativePath)' == 'libdoroti_webview_qt.so' or '%(ResolvedFileToPublish.RelativePath)' == 'doroti-webview-runtime.json'" />
      <ResolvedFileToPublish Include="@(_DorotiQtBundleNative)" RelativePath="%(Filename)%(Extension)" CopyToPublishDirectory="Always" ExcludeFromSingleFile="false" />
    </ItemGroup>
  </Target>
  <Target Name="ValidateDorotiQtRuntimePublish" BeforeTargets="PrepareForPublish"
          DependsOnTargets="ValidateDorotiQtConfiguration" Condition="'$(DorotiHostKind)' == 'Qt'">
    <Error Code="DOROTIQT012" Condition="'$(DorotiQtVersion)' != '6.12.0'"
           Text="Qt runtime bundling currently accepts Qt 6.12.0. DorotiQtVersion selects the Framework; DorotiQtProviderVersion selects the provider NuGet package version." />
    <Error Code="DOROTIQT010" Condition="'$(DorotiQtSdkDirectory)' == '' or ('$(DorotiQtWebEngine)' == 'true' and '$(DorotiQtWebEngineSdkDirectory)' == '')"
           Text="Qt publish requires an explicit Qt 6.12 SDK and an independent WebEngine SDK when enabled. Set DorotiQtSdkDirectory and DorotiQtWebEngineSdkDirectory. SDK installation is an explicit step." />
    <Error Code="DOROTIQT011" Condition="'$(PublishSingleFile)' == 'true' or '$(DorotiGStreamerTextures)' == 'true' or '$(DorotiQtQuick)' != 'true' or '$(DorotiQtGraphite)' != 'true'"
           Text="Qt runtime bundling currently requires Quick/Graphite directory output without GStreamer. Keep Qt shared libraries replaceable outside a single-file bundle." />
    <Error Code="DOROTIQT013" Condition="'$(DorotiPackageFormat)' == 'deb' and '$(_DorotiQtDebPackaging)' != 'true'"
           Text="Use the Qt provider publish -PackageFormat deb operation to collect and package the runtime. Direct dotnet publish with DorotiPackageFormat=deb is not a complete package operation." />
  </Target>
  <Target Name="BundleDorotiQtRuntime" AfterTargets="Publish" DependsOnTargets="CopyDorotiQtNative;ValidateDorotiQtRuntimePublish"
          Condition="'$(DorotiHostKind)' == 'Qt' and '$(DorotiPackageFormat)' != 'deb'">
    <Exec Command="python3 &quot;$(DorotiQtRuntimeTool)&quot; bundle --native &quot;$(DorotiQtNativeBuildDirectory)&quot; --publish &quot;$(PublishDir)&quot; --qt &quot;$(DorotiQtVersion)&quot; --sdk &quot;$(DorotiQtSdkDirectory)&quot; --web-view &quot;$(DorotiQtWebEngine)&quot; --webengine &quot;$(DorotiQtWebEngineVersion)&quot; --engine-sdk &quot;$(DorotiQtWebEngineSdkDirectory)&quot; --deployment &quot;$(DorotiQtWebEngineDeployment)&quot;" Timeout="1200000" />
  </Target>
</Project>
