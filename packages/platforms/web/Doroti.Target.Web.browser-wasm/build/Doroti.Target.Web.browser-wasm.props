<Project>
  <PropertyGroup>
    <DorotiWebTarget>true</DorotiWebTarget>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">browser-wasm</RuntimeIdentifier>
    <RuntimeFrameworkVersion Condition="'$(RuntimeFrameworkVersion)' == ''">10.0.11</RuntimeFrameworkVersion>
    <WasmBuildNative>true</WasmBuildNative>
    <WasmEnableThreads Condition="'$(WasmEnableThreads)' == ''">true</WasmEnableThreads>
    <!-- Also covers package consumers that do not import the runner SDK props. -->
    <RunAOTCompilation Condition="'$(UsingMicrosoftNETSdkBlazorWebAssembly)' == 'true' and '$(Configuration)' == 'Release' and '$(RunAOTCompilation)' == ''">true</RunAOTCompilation>
    <RunAOTCompilation Condition="'$(UsingMicrosoftNETSdkBlazorWebAssembly)' == 'true' and '$(Configuration)' == 'Debug' and '$(RunAOTCompilation)' == ''">false</RunAOTCompilation>
    <PublishTrimmed>true</PublishTrimmed>
    <InvariantGlobalization>false</InvariantGlobalization>
    <BlazorEnableTimeZoneSupport>true</BlazorEnableTimeZoneSupport>
    <DorotiSkiaInteropLibrary>$(MSBuildThisFileDirectory)DorotiSkiaInterop.js</DorotiSkiaInteropLibrary>
  </PropertyGroup>
  <ItemGroup>
    <EmccExportedFunction Include="_wgpuDeviceRelease;_wgpuQueueRelease;_wgpuInstanceRelease" />
    <DorotiApplicationAsset Include="wwwroot/assets/**/*" Condition="Exists('wwwroot\assets')" />
    <DorotiLocalizationResource Include="wwwroot/locales/**/*.json" Condition="Exists('wwwroot\locales')" />
    <DorotiFont Include="wwwroot/fonts/**/*" Condition="Exists('wwwroot\fonts')" />
  </ItemGroup>
</Project>
