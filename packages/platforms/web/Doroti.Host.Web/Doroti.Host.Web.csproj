<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Doroti.Host.Web</AssemblyName>
    <PackageId>Doroti.Host.Web</PackageId>
    <Description>Doroti browser render Worker, DOM, lifecycle, and requestAnimationFrame host capabilities.</Description>
    <IsDorotiProduct>true</IsDorotiProduct>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
    <DefaultItemExcludes>$(DefaultItemExcludes);Web\node_modules\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Content Remove="wwwroot/fonts/**" />
    <None Remove="wwwroot/fonts/**" />
    <EmbeddedResource Include="Fonts/fallbacks.bin" LogicalName="Doroti.Host.Web.Fonts.fallbacks.bin" />
    <None Update="Fonts/LICENSE.flutter.txt" Pack="true" PackagePath="licenses/Flutter-font-fallbacks.txt" />
    <PackageReference Include="Microsoft.TypeScript.MSBuild" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" />
    <ProjectReference Include="../../../../Doroti/src/Doroti.Hosting/Doroti.Hosting.csproj" />
    <ProjectReference Include="../../../../Doroti/src/Doroti.Ui/Doroti.Ui.csproj" />
    <ProjectReference Include="../../../../Doroti/src/Doroti.Skia.RuntimeEffects/Doroti.Skia.RuntimeEffects.csproj" />
    <ProjectReference Include="../../../../Doroti/src/Doroti.Skia.Rendering/Doroti.Skia.Rendering.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <DorotiWebTypeScript>true</DorotiWebTypeScript>
    <DorotiTypeScriptVersion>7.0.0</DorotiTypeScriptVersion>
    <DorotiTypeScriptConfig>$(MSBuildProjectDirectory)\Web\tsconfig.json</DorotiTypeScriptConfig>
    <DorotiTypeScriptSourceRoot>$(MSBuildProjectDirectory)\Web</DorotiTypeScriptSourceRoot>
    <DorotiTypeScriptOutputRoot>$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\Doroti.Web\wwwroot</DorotiTypeScriptOutputRoot>
    <DorotiTypeScriptExpectedOutput>$(DorotiTypeScriptOutputRoot)\doroti.loader.js</DorotiTypeScriptExpectedOutput>
    <DorotiTypeScriptStaticBasePath>wwwroot</DorotiTypeScriptStaticBasePath>
    <DorotiTypeScriptCopyToOutputDirectory>Never</DorotiTypeScriptCopyToOutputDirectory>
  </PropertyGroup>
  <ItemGroup>
    <None Include="Web/types/doroti-loader/index.d.ts" Pack="true" PackagePath="types/doroti-loader/index.d.ts" />
    <None Include="Web/types/doroti-textures/index.d.ts" Pack="true" PackagePath="types/doroti-textures/index.d.ts" />
  </ItemGroup>
  <Import Project="../../../../Doroti/src/Doroti.App.Sdk/Sdk/Doroti.TypeScript.targets" />
  <Target Name="DorotiRegisterWebSplashIcon"
          DependsOnTargets="ResolveStaticWebAssetsConfiguration"
          BeforeTargets="ResolveProjectStaticWebAssets;ResolveCurrentProjectStaticWebAssetsInputs">
    <PropertyGroup>
      <_DorotiWebBrandingRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '../../../../Doroti/docs/branding'))</_DorotiWebBrandingRoot>
    </PropertyGroup>
    <ItemGroup>
      <_DorotiWebSplashIcon Include="$(_DorotiWebBrandingRoot)doroti-app-icon.svg">
        <RelativePath>doroti-app-icon.svg</RelativePath>
        <CopyToOutputDirectory>Never</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </_DorotiWebSplashIcon>
    </ItemGroup>
    <!-- An external branding file needs its own content root for the dev server. -->
    <DefineStaticWebAssets CandidateAssets="@(_DorotiWebSplashIcon)"
        FingerprintCandidates="$(StaticWebAssetsFingerprintContent)" FingerprintPatterns="@(StaticWebAssetFingerprintPattern)"
        SourceId="$(PackageId)" SourceType="Discovered" ContentRoot="$(_DorotiWebBrandingRoot)" BasePath="$(StaticWebAssetBasePath)">
      <Output TaskParameter="Assets" ItemName="StaticWebAsset" />
      <Output TaskParameter="Assets" ItemName="_DorotiWebSplashStaticAsset" />
    </DefineStaticWebAssets>
    <DefineStaticWebAssetEndpoints CandidateAssets="@(_DorotiWebSplashStaticAsset)" ContentTypeMappings="@(StaticWebAssetContentTypeMapping)">
      <Output TaskParameter="Endpoints" ItemName="StaticWebAssetEndpoint" />
    </DefineStaticWebAssetEndpoints>
  </Target>
</Project>
