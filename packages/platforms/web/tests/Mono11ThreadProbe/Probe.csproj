<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <DorotiThreadProbeTargetFramework Condition="'$(DorotiThreadProbeTargetFramework)' == ''">net11.0</DorotiThreadProbeTargetFramework>
    <TargetFramework>$(DorotiThreadProbeTargetFramework)</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <RuntimeFrameworkVersion Condition="'$(RuntimeFrameworkVersion)' == '' and '$(TargetFramework)' == 'net11.0'">11.0.0</RuntimeFrameworkVersion>
    <RuntimeFrameworkVersion Condition="'$(RuntimeFrameworkVersion)' == ''">10.0.15</RuntimeFrameworkVersion>
    <UseMonoRuntime>true</UseMonoRuntime>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <WasmEnableThreads>true</WasmEnableThreads>
    <WasmBuildNative>false</WasmBuildNative>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="$(RuntimeFrameworkVersion)" /></ItemGroup>
</Project>
